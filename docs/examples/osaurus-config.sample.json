{
  "version": 1,
  "memory": {
    "enabled": true,
    "budget_tokens": 1200,
    "retention_days": 365
  },
  "harness_runtimes": [
    {
      "name": "Pi",
      "kind": "pi_rpc",
      "executable": "pi",
      "arguments": ["--mode", "rpc", "--session-id", "{chat_id}"],
      "environment": {}
    }
  ],
  "default_agent": {
    "name": null,
    "model": "foundation",
    "temperature": 0.7,
    "max_tokens": null,
    "system_prompt": "You are a friendly, concise assistant.",
    "runtime": "builtin"
  },
  "configurator": {
    "model": null,
    "temperature": null,
    "system_prompt": "Prefer the smallest change that does what I asked."
  },
  "new_chat_agent": "default",
  "model_defaults": { "core_model": "foundation", "compaction_model": null },
  "chat": {
    "smooth_streaming": true,
    "group_activity": true,
    "expand_thinking": false,
    "spell_check": false,
    "auto_titles": true,
    "follow_up_suggestions": true,
    "clipboard_monitoring": true,
    "keep_mac_awake": true
  },
  "app": { "hotkey": "cmd+;", "start_at_login": false, "show_notifications": true },
  "agents": [
    {
      "name": "Research Agent",
      "description": "Web research with cited sources",
      "system_prompt": "Research topics thoroughly and cite your sources.",
      "model": null,
      "temperature": 0.4,
      "max_tokens": 4096,
      "capabilities": {
        "tools_enabled": true,
        "web_search_enabled": true,
        "knowledge_enabled": true,
        "knowledge_collection_ids": [],
        "browser_use_enabled": false,
        "computer_use_enabled": false,
        "image_enabled": false,
        "applescript_enabled": false,
        "apple_apps": [],
        "relay_enabled": false
      },
      "tools": { "mode": "manual", "enabled": ["get_current_time", "web_search"] },
      "mcp_servers": { "enabled": [], "disabled": [] },
      "plugins": { "enabled": [] },
      "sandbox": { "enabled": true, "network_enabled": true, "allowed_domains": [] },
      "subagents": { "enabled": false, "agents": [], "models": [] },
      "working_folder": null
    }
  ],
  "tools": {
    "enabled": {
      "web_search": true
    },
    "policies": {
      "file_write": "ask"
    }
  },
  "delegation": {
    "local_text_enabled": true,
    "spawnable_agents": ["Research Agent"],
    "spawnable_workspace_agents": [],
    "workspace_auto_join": {},
    "permission_defaults": {
      "spawn": "always_allow",
      "spawn_workspace": "ask"
    },
    "budget_max_tokens": 8192,
    "budget_max_turns": 24,
    "budget_max_seconds": 900,
    "ram_safety_preflight": true
  },
  "commands": [
    {
      "name": "standup",
      "description": "Draft my standup update",
      "icon": "text.bubble",
      "template": "Draft a three-bullet standup update from this conversation."
    }
  ],
  "knowledge_collections": [
    {
      "name": "Team Docs",
      "folder_path": "~/Documents/TeamDocs",
      "summary": "Internal team documentation",
      "enabled": true,
      "include_globs": ["**/*.md"],
      "exclude_globs": ["**/drafts/**"]
    }
  ],
  "channels": {
    "write_enabled": true,
    "telegram": {
      "default_read_limit": 25,
      "sender_allowlist": ["123456789"],
      "require_mention": true,
      "bot_token_ref": "env:TELEGRAM_BOT_TOKEN"
    }
  },
  "mcp_servers": [
    {
      "name": "GitHub",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "enabled": true,
      "token_ref": "env:GITHUB_MCP_TOKEN"
    },
    {
      "name": "Filesystem",
      "transport": "stdio",
      "command": "/usr/local/bin/mcp-filesystem",
      "args": ["--root", "~/Projects"],
      "env": {
        "NODE_ENV": "production"
      },
      "secret_env_refs": {
        "API_TOKEN": "env:FS_MCP_TOKEN"
      },
      "execution_host": "sandbox",
      "enabled": true
    }
  ],
  "models": ["mlx-community/Qwen2.5-7B-Instruct-4bit"],
  "plugins": ["osaurus.fetch"],
  "providers": [
    {
      "name": "Anthropic",
      "provider": "anthropic",
      "enabled": true,
      "auto_connect": true,
      "api_key_ref": "env:ANTHROPIC_API_KEY"
    }
  ],
  "search_providers": {
    "ranking": ["tavily", "ddg_scrape"],
    "providers": [
      {
        "id": "tavily",
        "enabled": true
      }
    ]
  },
  "automations": [
    {
      "name": "Morning news",
      "agent": "Research Agent",
      "instructions": "Summarize the top technology headlines.",
      "source": {
        "kind": "schedule",
        "frequency": "daily",
        "frequency_time_of_day": "08:00"
      },
      "enabled": true
    },
    {
      "name": "Downloads sorter",
      "agent": "Research Agent",
      "instructions": "File new downloads into the right subfolder.",
      "source": {
        "kind": "folder",
        "path": "~/Downloads",
        "recursive": false,
        "responsiveness": "balanced"
      },
      "enabled": true
    },
    {
      "name": "Weekday digest",
      "workflow": "Daily Digest",
      "input": {
        "day": "{{schedule.scheduled_for}}"
      },
      "source": {
        "kind": "schedule",
        "frequency": "cron",
        "frequency_value": "0 8 * * 1-5"
      }
    },
    {
      "name": "Morning quote",
      "instructions": "Give me one short motivational quote.",
      "source": {
        "kind": "schedule",
        "frequency": "daily",
        "frequency_time_of_day": "07:30"
      }
    }
  ]
}
