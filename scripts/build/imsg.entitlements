<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Entitlements for the bundled imsg helper (Contents/Helpers/imsg).
  These mirror the entitlements upstream ships the binary with: sending an
  iMessage drives Messages.app over Apple Events, and handle resolution can
  read Contacts. The release re-sign must preserve both or sends fail with
  an Apple Events denial at runtime.
-->
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
</dict>
</plist>
