{
  "id": "tool_result_grounding.spawn-wave-pending-todo-finalizes-once",
  "domain": "tool_result_grounding",
  "label": "spawn_agent wave • grounded final does not reopen for optional pending Todos",
  "query": "Track the delegated work and two optional follow-ups, delegate the required work in one message, then finalize while leaving optional items pending.",
  "notes": "Model-free committed-transcript contract. The terminal Todo result explicitly leaves two optional items incomplete. Exact tool sequence, one wave of two spawn_agent calls, one final, and final-is-last reject a Todo-driven reopen or duplicate final after the grounded worker results.",
  "fixtures": {},
  "expect": {
    "toolResultGrounding": {
      "events": [
        {
          "kind": "toolCall",
          "callId": "todo-seed",
          "tool": "todo",
          "arguments": "{\"items\":[{\"id\":\"delegated\",\"text\":\"Collect both worker results\",\"completed\":false},{\"id\":\"optional-review\",\"text\":\"Optional review\",\"completed\":false},{\"id\":\"optional-notes\",\"text\":\"Optional notes\",\"completed\":false}]}"
        },
        {
          "kind": "toolResult",
          "callId": "todo-seed",
          "tool": "todo",
          "content": "TODO_SEEDED_03"
        },
        {
          "kind": "toolCall",
          "callId": "wave-a",
          "tool": "spawn_agent",
          "arguments": "{\"agent\":\"A11CE001-0000-4000-8000-000000000321\",\"input\":\"Return the alpha result.\"}"
        },
        {
          "kind": "toolCall",
          "callId": "wave-b",
          "tool": "spawn_agent",
          "arguments": "{\"agent\":\"A11CE001-0000-4000-8000-000000000322\",\"input\":\"Return the beta result.\"}"
        },
        {
          "kind": "toolResult",
          "callId": "wave-a",
          "tool": "spawn_agent",
          "content": "{\"ok\":true,\"tool\":\"spawn_agent\",\"result\":{\"kind\":\"spawn_result\",\"model\":\"test/todo-alpha\",\"summary\":\"TODO_BATCH_ALPHA_47\",\"session_id\":\"0F0F0F0F-0000-4000-8000-000000000021\",\"needs_input\":false}}"
        },
        {
          "kind": "toolResult",
          "callId": "wave-b",
          "tool": "spawn_agent",
          "content": "{\"ok\":true,\"tool\":\"spawn_agent\",\"result\":{\"kind\":\"spawn_result\",\"model\":\"test/todo-beta\",\"summary\":\"TODO_BATCH_BETA_83\",\"session_id\":\"0F0F0F0F-0000-4000-8000-000000000022\",\"needs_input\":false}}"
        },
        {
          "kind": "toolCall",
          "callId": "todo-final",
          "tool": "todo",
          "arguments": "{\"items\":[{\"id\":\"delegated\",\"text\":\"Collect both worker results\",\"completed\":true},{\"id\":\"optional-review\",\"text\":\"Optional review\",\"completed\":false},{\"id\":\"optional-notes\",\"text\":\"Optional notes\",\"completed\":false}]}"
        },
        {
          "kind": "toolResult",
          "callId": "todo-final",
          "tool": "todo",
          "content": "TODO_DELEGATED_DONE_88; optional-review=false; optional-notes=false"
        },
        {
          "kind": "assistant",
          "content": "Delegated work finished with TODO_BATCH_ALPHA_47 and TODO_BATCH_BETA_83. TODO_DELEGATED_DONE_88; the two optional items remain pending."
        }
      ],
      "assertions": [
        {
          "callId": "wave-a",
          "answerMustContain": [
            "TODO_BATCH_ALPHA_47"
          ],
          "argumentsMustNotContain": [
            "TODO_BATCH_ALPHA_47"
          ]
        },
        {
          "callId": "wave-b",
          "answerMustContain": [
            "TODO_BATCH_BETA_83"
          ],
          "argumentsMustNotContain": [
            "TODO_BATCH_BETA_83"
          ]
        },
        {
          "callId": "todo-final",
          "answerMustContain": [
            "TODO_DELEGATED_DONE_88"
          ],
          "resultMustContain": [
            "optional-review=false",
            "optional-notes=false"
          ],
          "argumentsMustNotContain": [
            "TODO_DELEGATED_DONE_88"
          ],
          "callMustFollowResultOf": "wave-b"
        }
      ],
      "expectedToolSequence": [
        "todo",
        "spawn_agent",
        "spawn_agent",
        "todo"
      ],
      "requireSingleFinalAssistant": true,
      "requireFinalAfterAllToolResults": true,
      "requireFinalIsLastEvent": true,
      "spawnWave": {
        "exactCallCount": 2,
        "expectedTargets": [
          "A11CE001-0000-4000-8000-000000000321",
          "A11CE001-0000-4000-8000-000000000322"
        ],
        "expectedSucceeded": 2,
        "expectedFailed": 0,
        "expectedWaveSizes": [
          2
        ],
        "expectedRows": [
          {
            "target": "A11CE001-0000-4000-8000-000000000321",
            "ok": true,
            "model": "test/todo-alpha",
            "summaryContains": [
              "TODO_BATCH_ALPHA_47"
            ]
          },
          {
            "target": "A11CE001-0000-4000-8000-000000000322",
            "ok": true,
            "model": "test/todo-beta",
            "summaryContains": [
              "TODO_BATCH_BETA_83"
            ]
          }
        ]
      }
    }
  }
}
