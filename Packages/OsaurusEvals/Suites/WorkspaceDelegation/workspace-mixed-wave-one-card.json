              "local:Writer"
            ],
            "refusals": [
              "",
              ""
            ],
            "policy": "always_allow",
            "cardKinds": [
              "spawn"
            ],
            "cardDescription": "Let this agent run 2 subagents in parallel?",
            "returnedArtifacts": [],
            "omittedArtifacts": []
          }
        ]
      }
