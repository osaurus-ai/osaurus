            {
              "name": "Research",
              "workspaceId": "ws-acme",
              "workspaceName": "Acme",
              "address": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01",
              "online": false,
              "lastSeenSecondsAgo": 120
            },
            {
              "name": "Writer",
              "workspaceId": "ws-acme",
              "workspaceName": "Acme",
              "address": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa02",
              "online": true,
              "lastSeenSecondsAgo": null
            }
          ],
          "localPolicy": "always_allow",
          "workspacePolicy": "ask",
          "steps": [
            {
              "targets": [
                "Research@Acme"
              ],
              "artifacts": null
            },
            {
              "targets": [
                "Writer@Acme"
              ],
              "artifacts": null
            },
            {
              "targets": [
                "Coder"
              ],
              "artifacts": null
            }
          ]
        },
        "expected": [
          {
            "resolutions": [
