              ""
            ],
            "policy": "deny",
            "cardKinds": [
              "spawn",
              "spawn_workspace"
            ],
            "cardDescription": "Let this agent run 2 subagents in parallel? 1 of them run on teammates' Macs and spend those workspaces' pools.",
            "returnedArtifacts": [],
            "omittedArtifacts": []
          }
        ]
      }
    }
