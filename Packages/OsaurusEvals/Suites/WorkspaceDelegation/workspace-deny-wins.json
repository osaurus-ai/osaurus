              "workspaceName": "Acme",
              "address": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01",
              "online": true,
              "lastSeenSecondsAgo": null
            }
          ],
          "localPolicy": "always_allow",
          "workspacePolicy": "deny",
          "steps": [
            {
              "targets": [
                "Coder",
                "Analyst@Acme"
              ],
              "artifacts": null
            }
          ]
        },
        "expected": [
          {
            "resolutions": [
              "local:Coder",
              "workspace:Analyst@Acme"
            ],
            "refusals": [
