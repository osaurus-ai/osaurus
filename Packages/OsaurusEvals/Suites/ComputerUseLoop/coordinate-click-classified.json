{
  "id": "computer_use_loop.coordinate-click-classified",
  "domain": "computer_use_loop",
  "label": "CU loop • a screenshot point is gated by the element it hits",
  "query": "Open the Next page.",
  "notes": "Deterministic (scripted-model) case for `target.point`: the model takes a screenshot (600×400 pixels of the 1200×800 window) and clicks pixel (70, 57), which maps to screen point (140, 114), on the Delete button. Its `describe` says Next, but a point decides the target, so the gate classifies the click as Delete and asks for approval (auto-approved here). Next must not be clicked.",
  "fixtures": {},
  "expect": {
    "computerUseLoop": {
      "app": "Files",
      "maxSteps": 5,
      "preset": "trusted",
      "vision": "local",
      "elements": [
        { "id": "next", "role": "button", "label": "Next", "onClick": { "setValues": [{ "id": "status", "value": "Page 2" }] } },
        { "id": "delete", "role": "button", "label": "Delete", "onClick": { "setValues": [{ "id": "status", "value": "Deleted" }] } },
        { "id": "status", "role": "statictext", "label": "Status", "value": "Page 1" }
      ],
      "successValues": [{ "id": "status", "equals": "Deleted" }],
      "successClicked": ["delete"],
      "failIfClicked": ["next"],
      "minConfirms": 1,
      "maxConfirms": 1,
      "feedTitleContains": ["Attached a screenshot"],
      "scriptedActions": [
        "{\"verb\":\"screenshot\",\"note\":\"look at the page\"}",
        "{\"verb\":\"click\",\"target\":{\"point\":{\"x\":70,\"y\":57},\"describe\":\"the Next button\"},\"note\":\"next page\"}",
        "{\"verb\":\"done\",\"reason\":\"clicked the button at that spot\"}"
      ]
    }
  }
}
