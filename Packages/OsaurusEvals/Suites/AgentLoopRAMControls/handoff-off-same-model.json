{
  "id": "agent_loop.ram-control-handoff-off-same-model",
  "domain": "agent_loop",
  "label": "Same-model sequential control: handoff-off-same-model",
  "query": "Use spawn_agent to ask RAM Admission Research to return exactly RAM_FIRST_OK. After that child has completed successfully, use spawn_agent to ask RAM Admission Marketing to return exactly RAM_SECOND_OK. Give neither child additional tasks or context. After both have completed, return both results. Issue the two calls in separate messages, one after the other, not in the same message.",
  "notes": "Live same-model sequential control. Exact executed child results required; only the named global control differs from the reporter baseline. This does not claim different-model coexistence or unload/restore proof.",
  "fixtures": {
    "agentCapabilities": {
      "spawnAgents": [
        {
          "id": "A11CE912-0000-4000-8000-000000000101",
          "name": "RAM Admission Research",
          "systemPrompt": ""
        },
        {
          "id": "A11CE912-0000-4000-8000-000000000102",
          "name": "RAM Admission Marketing",
          "systemPrompt": ""
        }
      ],
      "maxParallelSpawns": 1,
      "childBudgets": {
        "maxDelegateTokens": 2048,
        "maxDelegateTurns": 2,
        "maxElapsedSeconds": 120,
        "maxParallelSpawns": 1
      }
    },
    "runtimeConcurrency": {
      "continuousBatching": true,
      "maxConcurrentSequences": 1
    },
    "delegationSettings": {
      "ramSafety": true,
      "handoff": false,
      "coexistence": false
    }
  },
  "expect": {
    "agentLoop": {
      "maxIterations": 6,
      "maxModelSteps": 4,
      "mustCallTools": [
        "spawn_agent"
      ],
      "maxToolCalls": 2,
      "noDuplicateExecutedCalls": true,
      "noToolErrors": true,
      "allowedExits": [
        "finalResponse"
      ],
      "finalTextContains": [
        "RAM_FIRST_OK",
        "RAM_SECOND_OK"
      ],
      "toolUsageAudit": [
        {
          "tool": "spawn_agent",
          "minCalls": 2,
          "maxCalls": 2,
          "maxErrors": 0
        }
      ],
      "spawnSummaries": [
        "RAM_FIRST_OK",
        "RAM_SECOND_OK"
      ],
      "spawnAgentIDs": [
        "A11CE912-0000-4000-8000-000000000101",
        "A11CE912-0000-4000-8000-000000000102"
      ],
      "spawnWave": {
        "exactCallCount": 2,
        "expectedWaveSizes": [
          1,
          1
        ],
        "expectedSucceeded": 2,
        "expectedFailed": 0
      }
    }
  },
  "trials": 1,
  "passThreshold": 1
}
