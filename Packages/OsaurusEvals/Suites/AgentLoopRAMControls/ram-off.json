      "maxToolCalls": 2,
      "noDuplicateExecutedCalls": true,
      "noToolErrors": true,
      "allowedExits": [
        "finalResponse"
      ],
      "finalTextContains": [
        "RAM_FIRST_OK",
        "RAM_SECOND_OK"
      ],
      "toolUsageAudit": [
        {
          "tool": "spawn_agent",
          "minCalls": 2,
          "maxCalls": 2,
          "maxErrors": 0
        }
      ],
      "spawnSummaries": [
        "RAM_FIRST_OK",
        "RAM_SECOND_OK"
      ],
      "spawnAgentIDs": [
        "A11CE912-0000-4000-8000-000000000101",
        "A11CE912-0000-4000-8000-000000000102"
      ]
    }
  },
  "trials": 1,
