{
  "id": "subagent.scripted-batch-user-stop-all-cancelled",
  "domain": "subagent",
  "label": "Subagent • user stop settles batch as all_cancelled",
  "query": "Stop a two-child remote fan-out and preserve one terminal row per caller-stable job id.",
  "notes": "Model-free. Both remote-class children enter the real production batch host, then the real interrupt-center path stops them. The aggregate must settle exactly two rows in caller order, classify both as user_denied, report all_cancelled, and never duplicate a child row.",
  "fixtures": {},
  "expect": {
    "subagent": {
      "lane": "scripted",
      "decision": "allow",
      "scriptedBatch": [
        {
          "id": "cancel-a",
          "target": "scripted-remote",
          "remote": true,
          "runDelayMs": 5000,
          "rendezvousArrivals": 2
        },
        {
          "id": "cancel-b",
          "target": "scripted-remote",
          "remote": true,
          "runDelayMs": 5000,
          "rendezvousArrivals": 2
        }
      ],
      "interruptAfterMs": 100,
      "expectSuccess": false,
      "expectEnvelopeKind": "user_denied",
      "expectResultKind": "spawn_batch_result",
      "expectRunsCompleted": 0,
      "expectRunsSettled": 2,
      "expectRunEnvelopeKinds": [
        "user_denied",
        "user_denied"
      ],
      "expectBatchAggregateStatus": "all_cancelled",
      "expectBatchJobIDs": [
        "cancel-a",
        "cancel-b"
      ]
    }
  }
}
