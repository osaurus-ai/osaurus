          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) MLX 모델이므로 Osaurus에서 사용할 수 없습니다. 로컬 엔진은 MLX 형식 모델만 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не является моделью MLX, поэтому ее нельзя использовать в Osaurus. Локальный движок поддерживает только модели формата MLX."
