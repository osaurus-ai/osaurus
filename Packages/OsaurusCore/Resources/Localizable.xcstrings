    "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset."
          }
        },
        "ko" : {
          "stringUnit" : {
