    "Type / to open commands. ↑↓ to navigate, ↵ to select, Esc to dismiss." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe /, um Befehle zu öffnen. ↑↓ zum Navigieren, ↵ zum Auswählen, Esc zum Schließen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
