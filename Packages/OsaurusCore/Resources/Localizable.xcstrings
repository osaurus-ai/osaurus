        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 채팅, 프롬프트, 파일 및 키는 Mac 외부로 절대 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши чаты, промпты, файлы и ключи никогда не покинут ваш Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
