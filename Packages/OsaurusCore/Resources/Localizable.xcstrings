          }
        }
      }
    },
    "The AppleScript model stays loaded briefly after a run so back-to-back automations are faster.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das AppleScript-Modell bleibt nach einem Lauf kurz geladen, damit direkt aufeinanderfolgende Automationen schneller starten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 후에도 AppleScript 모델을 잠시 유지해 연속 자동화가 더 빠르게 시작됩니다."
          }
        },
