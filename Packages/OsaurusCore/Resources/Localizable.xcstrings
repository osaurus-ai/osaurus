          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n8n은 %@: sha256=<요청 본문 그대로의 16진수 HMAC-SHA256>을 보냅니다. 폴링 요청은 빈 본문에 서명합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
