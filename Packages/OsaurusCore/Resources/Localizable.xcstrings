    "Resetting clears sandbox plugin state. Agent workspace files on the host persist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zurücksetzen wird der Plugin-Zustand der Sandbox gelöscht. Agent-Arbeitsbereichsdateien auf dem Host bleiben erhalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설정하면 샌드박스 플러그인 상태가 지워집니다. 호스트의 에이전트 워크스페이스 파일은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сброс очищает состояние плагинов песочницы. Файлы рабочих областей агентов на хосте сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置将清除沙盒插件状态。主机上的智能体工作区文件将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置將清除沙盒插件狀態。主機上的代理工作區檔案將保留。"
          }
        }
      }
    },
    "Resetting destroys all installed sandbox packages. Agent workspace files on the host persist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Zurücksetzen zerstört alle installierten Sandbox-Pakete. Agent-Arbeitsbereichsdateien auf dem Host bleiben erhalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설정하면 설치된 모든 샌드박스 패키지가 파괴됩니다. 호스트의 에이전트 작업 공간 파일은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сброс уничтожает все установленные пакеты песочницы. Файлы рабочей области агента на хосте сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置会销毁所有已安装的沙盒包。主机上的智能体工作区文件会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置會銷毀所有已安裝的沙盒包。主機上的智能體工作區文件會保留。"
          }
        }
      }
    },
