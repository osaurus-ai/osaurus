    "Xcode builds need separate grants. Try 'tccutil reset AppleEvents' if stuck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode-Builds benötigen separate Berechtigungen. Bei Problemen: 'tccutil reset AppleEvents'."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 빌드에는 별도의 권한이 필요합니다. 문제가 발생하면 'tccutil reset AppleEvents'를 시도해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки Xcode требуют отдельных грантов. Попробуйте «tccutil сброс AppleEvents», если зависло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 构建需要单独授权。如果卡住，请尝试 'tccutil reset AppleEvents'。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 構建需要單獨授權。如果卡住，請嘗試 'tccutil reset AppleEvents'。"
          }
        }
      }
    },
