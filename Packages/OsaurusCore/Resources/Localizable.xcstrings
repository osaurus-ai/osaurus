      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No JSON-backed channels yet. Add a custom HTTP, Slack, or Telegram connection definition to prepare agent communication without storing secrets in the file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 JSON 기반 채널이 없습니다. 파일에 비밀을 저장하지 않고 에이전트 통신을 준비하려면 사용자 지정 HTTP, Slack 또는 Telegram 연결 정의를 추가하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
