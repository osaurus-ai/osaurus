    "Discover and install more themes shared by the Osaurus community" : {
      "comment" : "A description of the benefits of exploring and installing themes shared by the Osaurus community.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecke und installiere weitere Themes, die von der Osaurus-Community geteilt werden"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 커뮤니티에서 공유하는 더 많은 테마를 발견하고 설치하세요"
          }
        },
        "ru" : {
          "stringUnit" : {
