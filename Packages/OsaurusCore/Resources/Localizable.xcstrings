          }
        }
      }
    },
    "If the service shows a redirect URL error, add %@ to its app settings, then cancel and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Dienst einen Fehler zur Weiterleitungs-URL anzeigt, füge %@ in den App-Einstellungen hinzu, brich dann ab und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
