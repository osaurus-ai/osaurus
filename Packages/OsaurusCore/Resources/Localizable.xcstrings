        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отправке в этот чат передается доступный только для чтения снимок %@. Управляйте этим в настройках использования компьютера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
