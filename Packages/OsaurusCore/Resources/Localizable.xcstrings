    "Note: this agent uses a remote model, so its schema (table names and column types) is sent with each request. Row data is not.": {
      "comment": "A disclaimer explaining that a database schema is sent with every request, but row data is not.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Note: this agent uses a remote model, so its schema (table names and column types) is sent with each request. Row data is not."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Note: this agent uses a remote model, so its schema (table names and column types) is sent with each request. Row data is not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Note: this agent uses a remote model, so its schema (table names and column types) is sent with each request. Row data is not."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：此智能体使用远程模型，因此其模式（表名和列类型）会随每次请求发送。行数据不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：此智能體使用遠程模型，因此其模式（表名和列類型）會隨每次請求傳送。行數據不會傳送。"
          }
        }
      }
    },
