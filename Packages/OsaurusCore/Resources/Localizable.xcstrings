          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 모든 음성 모드(음성 입력, 전사 및 VAD 모드)에 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти настройки применяются ко всем голосовым режимам: голосовой ввод, транскрипция и режим VAD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
