    "privacy.review.subtitle": {
      "comment": "A subtitle explaining the purpose of the privacy review sheet.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Elemente werden durch Platzhalter ersetzt, bevor deine Nachricht deinen Mac verlässt. Deaktiviere alles, was du lieber unverändert senden möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items will be replaced with placeholders before your message leaves your Mac. Toggle off anything you'd rather send as-is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 메시지가 Mac을 떠나기 전에 자리 표시자로 바뀝니다. 있는 그대로 보내려는 항목은 끄세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти элементы будут заменены заполнителями, прежде чем ваше сообщение покинет ваш Mac. Отключите все, что вы предпочитаете отправлять как есть"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的消息离开 Mac 之前，这些项目将被替换为占位符。关闭任何你希望按原样发送的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的消息離開 Mac 之前，這些項目將被替換爲佔位符。關閉任何你希望按原樣發送的內容。"
          }
        }
      }
    },
