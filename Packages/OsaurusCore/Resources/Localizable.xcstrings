    "Qwen-Image 2.1 takes sizes in steps of 32 up to 2048, so %lld won't run. Try %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen-Image 2.1 nimmt Größen in Schritten von 32 bis 2048, daher läuft %1$lld nicht. Versuche %2$lld."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen-Image 2.1은 32 단위로 2048까지의 크기만 받으므로 %1$lld(으)로는 실행되지 않습니다. %2$lld을(를) 시도해 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen-Image 2.1 принимает размеры с шагом 32 до 2048, поэтому %1$lld не подойдёт. Попробуйте %2$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen-Image 2.1 的尺寸须为 32 的倍数且不超过 2048，因此 %1$lld 无法运行。请试试 %2$lld。"
          }
        }
      }
    },
