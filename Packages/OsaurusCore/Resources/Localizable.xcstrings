          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답은 항상 작업 URL을 폴링해 받을 수 있습니다. 아래 푸시를 켜면 n8n 웹훅 트리거에도 게시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы всегда доступны через опрос URL задачи. Включите отправку ниже, чтобы дополнительно публиковать их на триггер Webhook в n8n."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
