    " It also uses %@, which aren't limited to these folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Außerdem nutzt er %@, die nicht auf diese Ordner beschränkt sind."
