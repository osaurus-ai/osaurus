    "Sender '%@'. Nothing reached the agent yet. Allow or deny it under Channels → %@ → Prove it, then run the workflow again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Absender „%@“. Noch nichts hat den Agenten erreicht. Erlaube oder verweigere es unter „Kanäle → %@ → Beweisen“ und führe den Workflow dann erneut aus."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "발신자 '%@'. 아직 에이전트에 도달한 것은 없습니다. '채널 → %@ → 확인'에서 허용 또는 거부한 뒤 워크플로를 다시 실행하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отправитель «%@». До агента пока ничего не дошло. Разрешите или отклоните в «Каналы → %@ → Проверка», затем запустите рабочий процесс снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发送者“%@”。尚无内容到达智能体。请在“频道 → %@ → 验证”中允许或拒绝，然后再次运行工作流。"
          }
        }
      }
    },
    "Sender address" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Absenderadresse"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "보낸 사람 주소"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Адрес отправителя"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发件人地址"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
