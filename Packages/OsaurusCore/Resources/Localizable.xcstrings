        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 DFlash 2 草稿模型 — 其 config.json 中沒有選擇器。"
          }
        }
      }
    },
    "Select a downloaded DFlash 2 drafter folder": {
