          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 생성이 스트리밍되는 동안 백그라운드 추출이 일시 정지됩니다. GPU/통합 메모리를 공유하기 때문입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
