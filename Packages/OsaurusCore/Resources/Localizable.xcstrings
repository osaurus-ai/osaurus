          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off (recommended): mask ALL on-screen text before sending. On: send a screenshot where only detected sensitive text (names, emails, numbers, secrets) is masked — other text stays readable to the model."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off (recommended): mask ALL on-screen text before sending. On: send a screenshot where only detected sensitive text (names, emails, numbers, secrets) is masked — other text stays readable to the model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off (recommended): mask ALL on-screen text before sending. On: send a screenshot where only detected sensitive text (names, emails, numbers, secrets) is masked — other text stays readable to the model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭（推荐）：发送前遮蔽所有屏幕文本。开启：发送截图，其中仅检测到的敏感文本（姓名、邮箱、数字、密钥）被遮蔽 — 其余文本对模型保持可读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉（建議）：發送前遮蔽所有螢幕文字。開啟：發送螢幕截圖，其中僅檢測到的敏感文字（姓名、電子郵件、數字、金鑰）被遮蔽 — 其餘文字對模型保持可讀。"
          }
        }
      }
    },
    "off (this agent)" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "aus (dieser Agent)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔 (이 에이전트)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "выключен (этот агент)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭（此智能体）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉（此智能體）"
          }
        }
      }
    },
    "Off binds to 127.0.0.1 (this Mac only). On binds to 0.0.0.0 so phones, iPads, and other devices on your network can connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off binds to 127.0.0.1 (this Mac only). On binds to 0.0.0.0 so phones, iPads, and other devices on your network can connect."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 127.0.0.1(이 Mac 전용)에 바인딩됩니다. 켜면 0.0.0.0에 바인딩되어 네트워크의 휴대폰, iPad 및 기타 기기가 연결할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл. привязывается к 127.0.0.1 (только для этого Mac). On привязывается к 0.0.0.0, чтобы телефоны, iPad и другие устройства в вашей сети могли подключаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭则仅绑定到127.0.0.1（仅此Mac）。开启则绑定到0.0.0.0，这样手机、iPad和其他网络设备就可以连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉則僅綁定到127.0.0.1（僅此Mac）。開啓則綁定到0.0.0.0，這樣手機、iPad和其他網絡設備就可以連接。"
          }
        }
      }
    },
    "Off by default. Nothing is sent without this and on-device masking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standardmäßig deaktiviert. Ohne diese Option und die Gerätemaskierung wird nichts gesendet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 이 기능과 기기 내 마스킹 없이는 아무것도 전송되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Без этого и маскировки на устройстве ничего не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。没有此设置和本地脱敏处理，任何数据都不会被发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默認關閉。沒有此設置和本地脫敏處理，任何數據都不會被發送。"
          }
        }
      }
    },
    "Off by default. Requires Accessibility. Frozen when each conversation starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off by default. Requires Accessibility. Frozen when each conversation starts."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 접근성 권한이 필요합니다. 각 대화가 시작될 때 고정됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Требует доступности. Замораживается при начале каждого разговора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。需要辅助功能。每次对话开始时都冻结了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默認關閉。需要輔助功能。每次對話開始時都凍結了。"
          }
        }
      }
    },
    "Off by default. When on, each empty state generates a fresh greeting + quick actions on the configured Core Model. The first generation can feel slow on small models like Foundation; the static greeting still paints instantly. Per-agent overrides in the Customization tab still win." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig deaktiviert. Wenn aktiviert, erzeugt jeder Leerzustand eine neue Begrüßung + Schnellaktionen auf dem konfigurierten Core-Modell. Die erste Generierung kann sich bei kleinen Modellen wie Foundation langsam anfühlen; die statische Begrüßung wird trotzdem sofort angezeigt. Pro-Agent-Overrides im Tab „Anpassung“ haben weiterhin Vorrang."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 켜면 각 빈 상태에서 구성된 코어 모델을 통해 새로운 인사말과 빠른 작업이 생성됩니다. Foundation과 같은 작은 모델에서는 첫 번째 생성이 느리게 느껴질 수 있지만, 정적 인사말은 여전히 즉시 표시됩니다. 맞춤 설정 탭의 에이전트별 재정의가 여전히 우선 적용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Если этот параметр включен, каждое пустое состояние генерирует новое приветствие + быстрые действия для настроенной базовой модели. Первое поколение может показаться медленным на небольших моделях, таких как Foundation; статическое приветствие по-прежнему рисуется мгновенно. Переопределения для каждого агента на вкладке «Настройка» по-прежнему остаются в силе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。开启后，每个空白状态都会在配置的核心模型上生成全新的问候语和快捷操作。在 Foundation 等小型模型上，首次生成可能会感觉较慢；静态问候语仍会立即显示。“自定义”标签页中的按智能体覆盖项仍然优先。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默認關閉。開啓後，每個空白狀態都會在配置的核心模型上生成全新的問候語和快捷操作。在 Foundation 等小型模型上，首次生成可能會感覺較慢；靜態問候語仍會立即顯示。“自定義”標籤頁中的按智能體覆蓋項仍然優先。"
          }
        }
      }
    },
    "Off disables speculation. Auto uses it only when the model ships a verified native MTP head. Force-On requires that head." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off disables speculation. Auto uses it only when the model ships a verified native MTP head. Force-On requires that head."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 추측이 비활성화됩니다. 자동은 모델이 검증된 기본 MTP 헤드를 제공할 때만 사용합니다. 강제 켬은 해당 헤드가 필요합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл. отключает спекуляции. Auto использует его только тогда, когда модель поставляется с проверенной головкой MTP. Force-On требует этой головы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off 会禁用推测解码。Auto 仅在模型自带经验证的原生 MTP 头时使用。Force-On 要求该头存在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off 會禁用推測解碼。Auto 僅在模型自帶經驗證的原生 MTP 頭時使用。Force-On 要求該頭存在。"
          }
        }
      }
    },
    "Off: access expires in 90 days. On: access never expires until revoked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Zugriff läuft in 90 Tagen ab. An: Zugriff läuft nie ab, bis er widerrufen wird."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: 접근 권한이 90일 후에 만료됩니다. 켬: 접근 권한이 취소될 때까지 만료되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: доступ истекает через 90 дней. Вкл.: доступ не истекает, пока его не отзовут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：访问权限将在 90 天后过期。开启：访问权限在被撤销前永不过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：訪問權限將在 90 天后過期。開啓：訪問權限在被撤銷前永不過期。"
          }
        }
      }
    },
