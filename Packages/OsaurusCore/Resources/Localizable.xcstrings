    },
    "Summarizes older messages when a conversation nears the context limit. Unset uses the chat's current model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst ältere Nachrichten zusammen, wenn sich ein Gespräch dem Kontextlimit nähert. Ohne Auswahl wird das aktuelle Modell des Chats verwendet."
