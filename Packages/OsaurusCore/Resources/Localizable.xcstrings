    },
    "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile." : {
      "comment" : "A message in an alert that lets the user know that resetting a browser session is destructive and will delete the user's browsing data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除 %@ 的浏览数据 — cookie、登录信息及历史记录。该智能体将以全新的配置文件重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除 %@ 的瀏覽資料 — cookie、登入資訊及歷史記錄。代理將以全新的設定檔重新開始。"
          }
        }
      }
    },
