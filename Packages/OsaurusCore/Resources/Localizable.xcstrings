    "Actions that change or send something pause for your approval, based on the autonomy level below." : {
      "comment" : "Description of the safety model in the Computer Use settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktionen, die etwas ändern oder senden, werden je nach dem untenstehenden Autonomiegrad zur Genehmigung angehalten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가를 변경하거나 전송하는 작업은 아래의 자율성 수준에 따라 사용자의 승인을 받기 위해 일시 정지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия, которые меняют или отправляют что-то, приостанавливаются для вашего одобрения в зависимости от уровня автономии, указанного ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会更改或发送内容的操作会暂停等待你的批准，具体取决于下方的自主性级别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會更改或發送內容的操作會暫停等待您的批准，具體取決於下方的自主性級別。"
          }
        }
      }
    },
    "Activate" : {
      "localizations" : {
