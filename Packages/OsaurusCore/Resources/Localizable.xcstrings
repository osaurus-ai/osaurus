    "Standard workspaces bill each member's own credits. Shared agents run on their owner's Mac and stay end-to-end encrypted." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-Workspaces rechnen über das eigene Guthaben jedes Mitglieds ab. Freigegebene Agenten laufen auf dem Mac ihres Besitzers und bleiben Ende-zu-Ende-verschlüsselt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표준 작업 공간은 각 구성원의 크레딧으로 청구됩니다. 공유 에이전트는 소유자의 Mac에서 실행되며 종단 간 암호화가 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандартные рабочие области списывают кредиты каждого участника. Общие агенты работают на Mac владельца и остаются защищёнными сквозным шифрованием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标准工作区按每位成员自己的积分计费。共享代理在其所有者的 Mac 上运行，并保持端到端加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準工作空間按每位成員自己的點數計費。共享代理在其擁有者的 Mac 上執行，並保持端對端加密。"
          }
        }
      }
    },
    "Start a chat by saying an agent's wake phrase." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte einen Chat, indem du die Aktivierungsphrase eines Agenten sagst."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트의 호출 문구를 말해 채팅을 시작합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
