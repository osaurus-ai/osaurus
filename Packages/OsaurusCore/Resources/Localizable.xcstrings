          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 연결됨"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub подключён"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
