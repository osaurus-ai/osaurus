          }
        }
      }
    },
    "Osaurus could not reach huggingface.co to check %@. Check your connection and open the link again." : {
      "comment" : "Alert body when the Hub was unreachable. %@ is the repository id.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus konnte huggingface.co nicht erreichen, um %@ zu prüfen. Prüfe deine Verbindung und öffne den Link erneut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus가 %@을(를) 확인하기 위해 huggingface.co에 연결할 수 없습니다. 연결을 확인한 후 링크를 다시 여세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus не удалось подключиться к huggingface.co, чтобы проверить %@. Проверьте подключение и откройте ссылку снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 无法连接 huggingface.co 来检查 %@。请检查网络连接后重新打开链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 無法連線至 huggingface.co 來檢查 %@。請檢查網路連線後重新開啟連結。"
          }
        }
      }
    },
    "Osaurus couldn't connect to a model just now. Retry the connection, run a private model on this Mac, or use your own provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
