    },
    "We couldn’t verify your identity. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Identität konnte nicht bestätigt werden. Versuche es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
