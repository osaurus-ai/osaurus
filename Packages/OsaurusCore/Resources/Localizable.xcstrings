          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In the app, open the Bot page and turn on both privileged intents under “Privileged Gateway Intents”: Message Content Intent (required to read messages) and Server Members Intent (used to list senders)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In the app, open the Bot page and turn on both privileged intents under “Privileged Gateway Intents”: Message Content Intent (required to read messages) and Server Members Intent (used to list senders)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在应用中，打开机器人页面并启用“特权网关意图”下的两个特权意图：消息内容意图（读取消息所需）和服务器成员意图（用于列出发送者）。"
