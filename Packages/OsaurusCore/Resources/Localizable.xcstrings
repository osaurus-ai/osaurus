          }
        }
      }
    },
    "Agent steps hand a task to another agent, which answers with its own model, tools, and permissions. A teammate's shared agent runs on their Mac, which pays for it; only the task text is sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent-Schritte übergeben eine Aufgabe an einen anderen Agenten, der mit eigenem Modell, eigenen Tools und Berechtigungen antwortet. Der geteilte Agent eines Teammitglieds läuft auf dessen Mac, der dafür bezahlt; nur der Aufgabentext wird gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent steps hand a task to another agent, which answers with its own model, tools, and permissions. A teammate's shared agent runs on their Mac, which pays for it; only the task text is sent."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 단계는 자체 모델, 도구, 권한으로 답하는 다른 에이전트에게 작업을 넘깁니다. 팀원의 공유 에이전트는 팀원의 Mac에서 실행되며 비용도 그쪽이 부담합니다. 작업 텍스트만 전송됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги агента передают задачу другому агенту, который отвечает со своей моделью, инструментами и разрешениями. Общий агент коллеги работает на его Mac, который за это платит; отправляется только текст задачи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体步骤会把任务交给另一个智能体，由它用自己的模型、工具和权限回答。队友的共享智能体在其 Mac 上运行并承担费用；只发送任务文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能體步驟會把任務交給另一個智能體，由它用自己的模型、工具和權限回答。隊友的共享智能體在其 Mac 上執行並負擔費用；只傳送任務文字。"
          }
        }
      }
    },
    "Agent that replies" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwortender Agent"
          }
        },
        "ko" : {
