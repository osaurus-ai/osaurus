        }
      }
    },
    "This Mac was restored from a backup. Enter the recovery phrase of the account it came from to read its chats." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac wurde aus einem Backup wiederhergestellt. Gib die Wiederherstellungsphrase des ursprünglichen Kontos ein, um seine Chats zu lesen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac은 백업에서 복원되었습니다. 채팅을 읽으려면 원래 계정의 복구 문구를 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac восстановлен из резервной копии. Введите фразу восстановления исходной учётной записи, чтобы читать его чаты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 是从备份恢复的。输入其原账户的恢复短语即可读取它的聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 是從備份復原的。輸入其原帳號的復原短語即可讀取它的聊天。"
          }
        }
      }
    },
    "This Mac was restored from a backup. Enter your recovery phrase in Settings → Sync to read its chats." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac wurde aus einem Backup wiederhergestellt. Gib unter Einstellungen → Sync deine Wiederherstellungsphrase ein, um seine Chats zu lesen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac은 백업에서 복원되었습니다. 채팅을 읽으려면 설정 → 동기화에서 복구 문구를 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac восстановлен из резервной копии. Введите фразу восстановления в «Настройки → Синхронизация», чтобы читать его чаты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 是从备份恢复的。请在“设置 → 同步”中输入你的恢复短语以读取它的聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 是從備份復原的。請在「設定 → 同步」中輸入你的復原短語以讀取它的聊天。"
          }
        }
      }
    },
    "This Mac was restored from a backup. Enter your recovery phrase in Sharing → Devices to read its chats." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac wurde aus einem Backup wiederhergestellt. Gib unter Teilen → Geräte deine Wiederherstellungsphrase ein, um seine Chats zu lesen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac은 백업에서 복원되었습니다. 채팅을 읽으려면 공유 → 기기에서 복구 구문을 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac восстановлен из резервной копии. Чтобы читать его чаты, введите фразу восстановления в разделе «Общий доступ» → «Устройства»."
          }
        },
        "zh-Hans" : {
