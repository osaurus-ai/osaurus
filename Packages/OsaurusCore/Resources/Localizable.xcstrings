          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки → Управление данными → Экспорт данных. Ссылка для скачивания придёт по электронной почте в виде zip-файла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 → 数据控制 → 导出数据。下载链接将以 zip 文件形式通过电子邮件发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
