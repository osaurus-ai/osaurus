    "Your conversations were saved by a newer version of Osaurus. Update Osaurus to open them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterhaltungen wurden von einer neueren Osaurus-Version gespeichert. Aktualisiere Osaurus, um sie zu öffnen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 더 새로운 버전의 Osaurus로 저장되었습니다. 열려면 Osaurus를 업데이트하세요."
          }
        },
        "ru" : {
