          }
        }
      }
    },
    "The signing secret only verifies Slack HTTP (Events API) requests. Native Slack receive uses Socket Mode and never needs it; keep it only for future webhook compatibility.": {
      "comment": "A footnote explaining the purpose of the signing secret.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The signing secret only verifies Slack HTTP (Events API) requests. Native Slack receive uses Socket Mode and never needs it; keep it only for future webhook compatibility."
          }
        },
        "ko": {
          "stringUnit": {
