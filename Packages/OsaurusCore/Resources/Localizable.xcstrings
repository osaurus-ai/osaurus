    "Keeps model memory resident for %d minutes after the last generation finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Modellspeicher %d Minuten nach Abschluss der letzten Generierung resident."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keeps model memory resident for %d minutes after the last generation finishes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 생성이 완료된 후 %d분 동안 모델 메모리를 상주 상태로 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет резидентность памяти модели в течение %d минут после завершения последней генерации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最后一次生成完成后，将模型内存保持驻留 %d 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最後一次生成完成後，將模型內存保持駐留 %d 分鐘。"
          }
        }
      }
    },
    "Keeps model memory resident until manual unload, model switch, memory cleanup, or quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Modellspeicher resident bis zum manuellen Entladen, Modellwechsel, zur Speicherbereinigung oder zum Beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keeps model memory resident until manual unload, model switch, memory cleanup, or quit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 언로드, 모델 전환, 메모리 정리 또는 종료할 때까지 모델 메모리를 상주 상태로 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет память модели до ручной выгрузки, переключения модели, очистки памяти или выхода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将模型内存保持驻留，直至手动卸载、切换模型、清理内存或退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將模型內存保持駐留，直至手動卸載、切換模型、清理內存或退出。"
          }
        }
      }
    },
    "Keeps models loaded until manually unloaded. Requires 32GB+ RAM.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Modelle geladen bis zum manuellen Entladen. Erfordert 32 GB+ RAM."
