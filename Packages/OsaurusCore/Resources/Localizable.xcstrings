    "privacy.custom.editor.patternMatchesEmpty": {
      "comment": "Error shown when the pattern matches the empty string and would cause an infinite loop.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Muster passt auf die leere Zeichenfolge. Verschärfe es, sodass es mindestens ein Zeichen erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern matches the empty string. Tighten it so it requires at least one character."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴이 빈 문자열과 일치합니다. 하나 이상의 문자가 필요하도록 엄격하게 조정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон соответствует пустой строке. Затяните его так, чтобы требовался хотя бы один символ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模式会匹配空字符串。请收紧它，使其至少要求一个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該模式會匹配空字符串。請收緊它，使其至少要求一個字符。"
          }
        }
      }
    },
    "privacy.custom.editor.patternTooLong": {
