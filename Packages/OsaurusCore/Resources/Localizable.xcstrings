    "The AppleScript model stays loaded briefly after a run so back-to-back automations are faster." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das AppleScript-Modell bleibt nach einem Lauf kurz geladen, damit direkt aufeinanderfolgende Automationen schneller starten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 후에도 AppleScript 모델을 잠시 유지해 연속 자동화가 더 빠르게 시작됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель AppleScript ненадолго остаётся загруженной после запуска, поэтому последовательные автоматизации выполняются быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScript 模型在运行后会短暂保持加载，让连续的自动化更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScript 模型在運行後會短暫保持加載，讓連續的自動化更快。"
          }
        }
      }
    },
    "The brain you picked is on the way" : {
