        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 데이터베이스를 열지 못했습니다. 콘솔에서 SQLCipher 오류와 저장소 마이그레이션 로그를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных памяти не открылась. Проверьте консоль на наличие ошибок SQLCipher и журналов миграции хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存数据库无法打开。请检查控制台中的 SQLCipher 错误和存储迁移日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內存數據庫無法打開。請檢查控制檯中的SQLCipher錯誤和存儲遷移日誌。"
          }
        }
      }
    },
