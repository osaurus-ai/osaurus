        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 내 에이전트입니다. 해당 기기의 도구와 파일을 사용해 그곳에서 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши агенты на %@. Они работают там, с его инструментами и файлами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 上的智能体。它们在那里运行，使用那台设备的工具和文件。"
          }
        },
