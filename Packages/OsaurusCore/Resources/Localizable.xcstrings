    },
    "Lower = focused. Higher = creative. 0 picks the single most-likely token." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lower = focused. Higher = creative. 0 picks the single most-likely token."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮음 = 집중. 높음 = 창의적. 0은 가장 가능성 있는 단일 토큰을 선택합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижний = сосредоточенный. Высшее = креатив. 0 выбирает один наиболее вероятный токен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值越低，输出越专注；数值越高，越具创造性。设为 0 则始终选取概率最高的单个 Token。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
