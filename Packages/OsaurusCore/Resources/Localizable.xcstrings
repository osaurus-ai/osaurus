    "The memory database failed to open for an unrecognized reason.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Speicherdatenbank konnte aus einem nicht erkannten Grund nicht geöffnet werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 이유로 메모리 데이터베이스를 열지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных памяти не открылась по неизвестной причине."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆数据库因未知原因未能打开。"
          }
