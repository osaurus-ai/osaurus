          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "채널 목록에서 알아볼 수 있는 이름입니다. 아래 ID는 이름을 따르며 웹훅 URL에 표시됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
