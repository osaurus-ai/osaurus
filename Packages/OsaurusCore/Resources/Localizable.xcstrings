          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code나 Pi처럼 에이전트의 채팅을 실행하는 외부 에이전트 하네스입니다. 에이전트의 구성 탭에서 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внешние среды запуска агентов, например Claude Code или Pi, которые ведут чаты агента. Выберите среду на вкладке «Настроить» агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行智能体聊天的外部智能体运行环境，例如 Claude Code 或 Pi。在智能体的“配置”标签页中选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行智能體聊天的外部智能體執行環境，例如 Claude Code 或 Pi。在智能體的「配置」分頁中選擇一個。"
          }
        }
      }
