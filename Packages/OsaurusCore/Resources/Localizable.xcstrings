    "Downloads without a token are rate-limited by Hugging Face and can be slow or fail under load." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads ohne Token werden von Hugging Face durch Ratenlimits gedrosselt und können langsam sein oder unter Last fehlschlagen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰 없이 다운로드하면 Hugging Face의 속도 제한이 적용되어 느리거나 부하 시 실패할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки без токена ограничиваются Hugging Face по частоте запросов и могут быть медленными или прерываться при нагрузке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有令牌的下载会受到 Hugging Face 的速率限制，可能很慢或在高负载时失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有權杖的下載會受到 Hugging Face 的速率限制，可能很慢或在高負載時失敗。"
          }
        }
      }
    },
