    "Cap how far this agent can act, even when your global policy is more permissive." : {
      "comment" : "A description of what the autonomy ceiling picker does.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Begrenzt den Handlungsspielraum dieses Agenten, selbst wenn Ihre globale Richtlinie weiterreichendere Berechtigungen erlaubt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전역 정책이 더 허용적인 경우에도 이 에이전트가 작동할 수 있는 한도를 설정합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничьте, насколько далеко может действовать этот агент, даже если ваша глобальная политика более либеральна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制此智能体的行动范围，即使您的全局策略允许更多权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制此智能體的行動範圍，即使您的全局策略允許更多權限。"
          }
        }
      }
    },
