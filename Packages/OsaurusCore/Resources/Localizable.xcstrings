        }
      }
    },
    "These `.mcp.json` entries were malformed (no `command` and no `url`) and couldn't be imported:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese `.mcp.json`-Einträge waren fehlerhaft (kein `command` und keine `url`) und konnten nicht importiert werden:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 `.mcp.json` 항목은 형식이 잘못되어(`command` 및 `url` 없음) 가져올 수 없습니다:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти записи `.mcp.json` были неверными (нет `command` и нет `url`) и не могли быть импортированы:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
