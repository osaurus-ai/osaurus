    "Custom channels are outbound-only until you authorize incoming senders. Anything posted to the inbound inbox API from senders not listed here is denied." : {
      "comment" : "A note explaining that custom channels can only be used outbound-wise, and that only certain senders can send to them.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Custom channels are outbound-only until you authorize incoming senders. Anything posted to the inbound inbox API from senders not listed here is denied."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Custom channels are outbound-only until you authorize incoming senders. Anything posted to the inbound inbox API from senders not listed here is denied."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Custom channels are outbound-only until you authorize incoming senders. Anything posted to the inbound inbox API from senders not listed here is denied."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义频道仅限出站，直到你授权传入发送者。从此处未列出的发送者发布到传入收件箱 API 的任何内容都会被拒绝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂頻道僅限出站，直到您授權傳入傳送者。從此處未列出的傳送者發佈到傳入收件匣 API 的任何內容都會被拒絕。"
          }
        }
      }
    },
