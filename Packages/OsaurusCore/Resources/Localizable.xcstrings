    "Manual fallback for servers not returned by discovery." : {
      "comment" : "Help text for the \"Server IDs\" field in the Discord settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual fallback for servers not returned by discovery."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual fallback for servers not returned by discovery."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual fallback for servers not returned by discovery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为自动发现未能返回的服务器提供的手动回退。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未被發現返回的伺服器的手動回退。"
          }
        }
      }
    },
    "Manual ID fields are under Advanced for entries discovery cannot see." : {
      "comment" : "A footnote explaining that manual IDs are only shown in the \"Advanced\" section when the bot does not have permission to discover channels and members.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual ID fields are under Advanced for entries discovery cannot see."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual ID fields are under Advanced for entries discovery cannot see."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual ID fields are under Advanced for entries discovery cannot see."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于自动发现看不到的条目，可使用高级选项下的手动 ID 字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動 ID 字段位於進階選項下，用於發現無法看到的條目。"
          }
        }
      }
    },
    "Manual IDs are a fallback for chats not returned by discovery. Direct chats use E.164 phone numbers (+15551234567); groups use their JID (1203630XXXX@g.us)." : {
      "comment" : "A description of how to enter WhatsApp chat IDs.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuelle IDs sind ein Fallback für Chats, die die Erkennung nicht liefert. Direktchats verwenden E.164-Telefonnummern (+15551234567); Gruppen ihre JID (1203630XXXX@g.us)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동 ID는 검색으로 찾을 수 없는 채팅을 위한 대비책입니다. 1:1 채팅은 E.164 전화번호(+15551234567)를, 그룹은 JID(1203630XXXX@g.us)를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ручные идентификаторы — запасной вариант для чатов, которые не вернуло обнаружение. Личные чаты используют номера E.164 (+15551234567); группы — свой JID (1203630XXXX@g.us)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动 ID 是发现功能未返回的聊天的后备方案。私聊使用 E.164 电话号码（+15551234567）；群组使用其 JID（1203630XXXX@g.us）。"
          }
        }
      }
    },
    "Manual IDs are a fallback for chats not returned by discovery. Use the chat GUID (e.g. iMessage;-;+15551234567) or a direct handle." : {
      "comment" : "A description of how to enter custom chat IDs.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
