    },
    "We couldn’t redeem this code. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code konnte nicht eingelöst werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 사용할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось активировать код. Проверьте подключение и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法兑换代码。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法兌換代碼。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "We couldn’t set up your Osaurus Identity. Please try again.": {
      "localizations": {
