    "This model runs right here on your Mac, so nothing you type leaves it and it works offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell läuft direkt auf deinem Mac. Nichts, was du eingibst, verlässt ihn, und es funktioniert offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个模型直接在你的 Mac 上运行，你输入的内容不会离开它，而且可以离线使用。"
          }
