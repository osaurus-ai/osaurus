    "%@ came with Osaurus. Run it once here to see what it gives you. If you like it, it can run on its own later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bei Osaurus dabei. Führe es hier einmal aus, um zu sehen, was es dir liefert. Wenn es dir gefällt, kann es später von selbst laufen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Osaurus에 기본으로 들어 있습니다. 여기서 한 번 실행해 어떤 결과를 주는지 확인해 보세요. 마음에 들면 나중에 자동으로 실행되게 할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ входит в Osaurus. Запустите его здесь один раз и посмотрите, что он дает. Если понравится, позже он сможет запускаться сам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 Osaurus 自带的。在这里运行一次，看看它能给你什么。如果喜欢，之后可以让它自动运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 Osaurus 內建的。在這裡執行一次，看看它能給你什麼。如果喜歡，之後可以讓它自動執行。"
          }
        }
      }
    },
    "%@ can point out the names, numbers, and addresses in a file. Its folder stays read only, so the file is never changed." : {
      "comment" : "A line in a card that describes a redaction.",
      "isCommentAutoGenerated" : true
    },
    "%@ can read and draft your texts too. macOS asks for Full Disk Access first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann auch deine Nachrichten lesen und Antworten entwerfen. macOS fragt zuerst nach vollständigem Festplattenzugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can read and draft your texts too. macOS asks for Full Disk Access first."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@도 문자를 읽고 답장 초안을 쓸 수 있습니다. 먼저 macOS가 전체 디스크 접근 권한을 묻습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ также может читать ваши сообщения и готовить ответы. Сначала macOS запросит полный доступ к диску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 也可以读取你的短信并起草回复。macOS 会先请求完全磁盘访问权限。"
          }
        },
