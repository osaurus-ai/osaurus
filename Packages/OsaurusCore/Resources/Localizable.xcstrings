    "1 document has no category. This is optional, agents can still search and read it. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of the file. Click for the list.": {
      "comment": "Help text for the \"No category\" list in the knowledge collection card.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 document has no category. This is optional, agents can still search and read it. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of the file. Click for the list."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 document has no category. This is optional, agents can still search and read it. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of the file. Click for the list."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 document has no category. This is optional, agents can still search and read it. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of the file. Click for the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 篇文档未设置分类。此项为可选配置，智能体仍可搜索和读取该文档。若要让智能体按分类筛选，请在文件顶部添加 `type:` 字段（例如 `type: policy`）。点击查看文档列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 份文件未設定分類。此為可選設定，代理仍可搜尋和閱讀該檔案。若要讓代理按分類篩選，請在檔案頂部添加 `type:` 欄位（例如 `type: policy`）。點擊查看檔案列表。"
          }
        }
      }
    },
