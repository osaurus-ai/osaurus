    "Osaurus will quit and reopen in this Space. Running chats and workflows will stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Osaurus wird beendet und in diesem Space neu geöffnet. Laufende Chats und Workflows werden angehalten."
          }
        },
        "ko" : {
          "stringUnit" : {
