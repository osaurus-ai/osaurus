        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內存數據庫因未知原因無法打開。"
          }
        }
      }
    },
    "The memory database isn't open. It may still be initializing, or it failed silently — try Retry.": {
      "comment": "Detail text for the \"Memory DB open\" row when the memory database isn't open.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Speicherdatenbank ist nicht geöffnet. Es kann immer noch initialisiert werden, oder es ist stillschweigend fehlgeschlagen - versuchen Sie es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 데이터베이스가 열려 있지 않습니다. 아직 초기화 중이거나 조용히 실패했을 수 있습니다. 다시 시도를 해보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных памяти не открыта. Возможно, она ещё инициализируется или произошёл тихий сбой. Нажмите «Повторить»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆数据库未打开。它可能仍在初始化，或者已静默失败——请尝试重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內存數據庫未打開。它可能仍在初始化，或者已靜默失敗——請嘗試重試。"
          }
        }
      }
    },
