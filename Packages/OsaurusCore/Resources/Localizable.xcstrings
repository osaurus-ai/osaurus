    "%lld documents have no category. This is optional, agents can still search and read them. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of each file. Click for the list.": {
      "comment": "A description of a warning about some documents not having a category. The argument is the number of documents without a category.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld documents have no category. This is optional, agents can still search and read them. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of each file. Click for the list."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld documents have no category. This is optional, agents can still search and read them. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of each file. Click for the list."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld documents have no category. This is optional, agents can still search and read them. To let agents filter by category, add a `type:` line (e.g. `type: policy`) to the top of each file. Click for the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 篇文档未设置分类。此项为可选配置，智能体仍可搜索和读取这些文档。若要让智能体按分类筛选，请在每个文件的顶部添加 `type:` 字段（例如 `type: policy`）。点击查看文档列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 份文件未設定分類。此為可選設定，代理仍可搜尋和閱讀這些檔案。若要讓代理按分類篩選，請在每個檔案頂部添加 `type:` 欄位（例如 `type: policy`）。點擊查看檔案列表。"
          }
        }
      }
    },
