            "value": "Searches go through Osaurus first — search credits, then your wallet — and fall back to the sources below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Searches go through Osaurus first — search credits, then your wallet — and fall back to the sources below."
