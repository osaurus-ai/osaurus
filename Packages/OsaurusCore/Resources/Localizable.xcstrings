    "The image prompt exceeds this model's %d character limit.": {
      "comment": "A localized string that describes the number of characters allowed in a prompt for a specific model.",
      "isCommentAutoGenerated": true
    },
    "The invite link will stop working. Anyone trying to use it will be turned away.": {
