    "Supports http, https, socks, and socks5 URLs with an explicit host and port. Credentials are not accepted here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supports http, https, socks, and socks5 URLs with an explicit host and port. Credentials are not accepted here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적인 호스트 및 포트가 있는 http, https, socks 및 socks5 URL을 지원합니다. 자격 증명은 여기서 허용되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживает http, https, Socks и Socks5 URL с явным указанием хоста и порта. Сертификаты здесь не принимаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 http、https、socks 和 socks5 协议的 URL，需明确指定主机和端口。此处不接受凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 http、https、socks 和 socks5 協議的 URL，需明確指定主機和端口。此處不接受憑據。"
          }
        }
      }
    },
