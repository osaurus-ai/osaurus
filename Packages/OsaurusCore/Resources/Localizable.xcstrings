    "The agent will send messages to %@ on its own, without a confirmation from you. Room allowlists, rate limits, and the global Sending switch still apply.": {
      "comment": "A message in a window-level alert that lets the user confirm allowing an agent to post without a confirmation. The argument is the name of the agent.",
      "isCommentAutoGenerated": true
    },
    "The agent will send messages to this room on its own, without a confirmation from you. Room allowlists, rate limits, and the global Sending switch still apply.": {
      "comment": "Confirmation dialog message for allowing auto-send.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
