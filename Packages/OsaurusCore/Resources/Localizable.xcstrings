    "You can also answer from the notification or your paired phone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst auch über die Mitteilung oder dein gekoppeltes Telefon antworten."
