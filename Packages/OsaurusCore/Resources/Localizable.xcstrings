    "Combines the /models response with Fireworks' serverless model catalog, since /models only lists the account's deployed models.": {},
    "Comma-separated (e.g. api.github.com, *.example.com). When set, sandbox traffic goes through a host proxy that only permits these domains. Takes effect on next sandbox start.": {
      "comment": "A description of the format and effect of the \"Allowed Domains\" field in the agent detail view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comma-separated (e.g. api.github.com, *.example.com). When set, sandbox traffic goes through a host proxy that only permits these domains. Takes effect on next sandbox start."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comma-separated (e.g. api.github.com, *.example.com). When set, sandbox traffic goes through a host proxy that only permits these domains. Takes effect on next sandbox start."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comma-separated (e.g. api.github.com, *.example.com). When set, sandbox traffic goes through a host proxy that only permits these domains. Takes effect on next sandbox start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗号分隔（例如 api.github.com, *.example.com）。设置后，沙盒流量将通过仅允许这些域名的主机代理。在下次沙盒启动时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
