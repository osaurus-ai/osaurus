          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除你的所有數據，包括聊天歷史、智能體、記憶和身份密鑰。此操作無法撤銷，應用將會關閉。"
          }
        }
      }
    },
