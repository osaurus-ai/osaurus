    },
    "Your message hasn't been sent yet. Retry, or send it without a summary — older messages will be trimmed to fit instead." : {
      "comment" : "Explains the options after an automatic compaction fails while a send is waiting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Nachricht wurde noch nicht gesendet. Versuche es erneut oder sende sie ohne Zusammenfassung — ältere Nachrichten werden dann stattdessen gekürzt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지가 아직 전송되지 않았습니다. 다시 시도하거나 요약 없이 보내세요. 이 경우 이전 메시지는 맞추기 위해 잘립니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше сообщение ещё не отправлено. Повторите попытку или отправьте его без сводки — тогда старые сообщения будут обрезаны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的消息尚未发送。请重试，或不带摘要直接发送——较早的消息将被裁剪以适应窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
