      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Repo hat die MLX-kompatible Metadaten-/Dateiprüfung nicht bestanden. Verwende ein MLX-, MXFP-, JANG-, JANGTQ- oder TurboQuant-Repo mit Konfiguration, Tokenizer und Modellgewichten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소는 MLX 호환 메타데이터/파일 검사를 통과하지 못했습니다. 구성, 토크나이저 및 모델 가중치가 포함된 MLX, MXFP, JANG, JANGTQ 또는 TurboQuant 저장소를 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот репозиторий не прошёл проверку метаданных и файлов на совместимость с MLX. Используйте репозиторий MLX, MXFP, JANG, JANGTQ или TurboQuant с конфигурацией, токенизатором и весами модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
