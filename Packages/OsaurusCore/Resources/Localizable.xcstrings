    "Authorization fails closed: an event is accepted only when its conversation_id and sender.id are both listed here." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Autorisierung ist standardmäßig geschlossen: Ein Ereignis wird nur akzeptiert, wenn sowohl conversation_id als auch sender.id hier aufgeführt sind."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 부여는 기본 거부입니다. conversation_id와 sender.id가 모두 여기에 등록된 경우에만 이벤트를 허용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторизация закрыта по умолчанию: событие принимается, только если и conversation_id, и sender.id указаны здесь."
          }
        },
        "zh-Hans" : {
