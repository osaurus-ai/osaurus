        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일에 대해 폴더를 모니터링합니다 — 변경 사항이 있을 때마다 에이전트가 자동으로 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
