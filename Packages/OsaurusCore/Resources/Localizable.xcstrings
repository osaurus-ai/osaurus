    "Same Network" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiches Netzwerk"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Та же сеть"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一网络"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一網路"
          }
        }
      }
    },
    "Same Network reaches devices on your Wi-Fi or Ethernet. Anywhere also connects through Osaurus servers, so your devices sync on different networks. Chats stay end-to-end encrypted either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gleiches Netzwerk“ erreicht Geräte in deinem WLAN oder Ethernet. „Überall“ verbindet zusätzlich über Osaurus-Server, sodass deine Geräte auch in verschiedenen Netzwerken synchronisieren. Chats bleiben in beiden Fällen Ende-zu-Ende-verschlüsselt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크는 Wi-Fi 또는 이더넷의 기기에 연결합니다. 어디서나는 Osaurus 서버를 통해서도 연결되므로 다른 네트워크에서도 기기가 동기화됩니다. 어느 쪽이든 채팅은 종단 간 암호화됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Та же сеть» связывает устройства в вашей сети Wi-Fi или Ethernet. «Везде» дополнительно подключается через серверы Osaurus, поэтому устройства синхронизируются и в разных сетях. В обоих случаях чаты защищены сквозным шифрованием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“同一网络”连接你 Wi-Fi 或以太网中的设备。“任何地方”还会通过 Osaurus 服务器连接，让你的设备在不同网络中也能同步。两种方式下聊天都保持端到端加密。"
          }
        }
      }
    },
    "Same Network reaches devices on your Wi-Fi or Ethernet. Anywhere also connects through relay servers, so your devices sync on different networks." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gleiches Netzwerk“ erreicht Geräte in deinem WLAN oder Ethernet. „Überall“ verbindet sich zusätzlich über Relay-Server, sodass deine Geräte auch in verschiedenen Netzwerken synchronisieren."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'같은 네트워크'는 Wi-Fi 또는 이더넷에 있는 기기에 연결합니다. '어디서나'는 릴레이 서버를 통해서도 연결하므로 서로 다른 네트워크에 있는 기기도 동기화됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Та же сеть» находит устройства в вашей сети Wi-Fi или Ethernet. «Везде» также подключается через серверы-ретрансляторы, поэтому устройства синхронизируются и в разных сетях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“同一网络”可连接你的 Wi-Fi 或以太网中的设备。“任何地方”还会通过中继服务器连接，让你的设备在不同网络中也能同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「同一網路」可連接你的 Wi-Fi 或乙太網路中的裝置。「任何地方」還會透過中繼伺服器連接，讓你的裝置在不同網路中也能同步。"
          }
        }
      }
    },
    "Same Network reaches devices on your Wi-Fi or Ethernet. Anywhere also uses shared development servers, for beta testing." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiches Netzwerk erreicht Geräte in deinem WLAN oder Ethernet. Überall nutzt zusätzlich gemeinsame Entwicklungsserver, für Betatests."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크는 Wi-Fi 또는 이더넷의 기기에 연결합니다. 어디서나는 베타 테스트용 공유 개발 서버도 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Та же сеть» находит устройства в вашей сети Wi-Fi или Ethernet. «Везде» также использует общие серверы разработки — для бета-тестирования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“同一网络”可连接你的 Wi-Fi 或以太网中的设备。“任何地方”还会使用共享的开发服务器，供测试版使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「同一網路」可連線你的 Wi-Fi 或乙太網路中的裝置。「任何地方」還會使用共享的開發伺服器，供測試版使用。"
          }
        }
      }
    },
