    },
    "This will remove the provider and all its tools. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies entfernt den Anbieter und alle seine Werkzeuge. Dies kann nicht rueckgaengig gemacht werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 제공자와 모든 도구를 제거합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приведет к удалению провайдера и всех его инструментов. Это невозможно отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
