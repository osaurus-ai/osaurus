    "Adds %@ to the pool for %@ — no fee. Unlike the monthly grant, these credits don't expire." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dem Pool %@ für %@ hinzu – ohne Gebühr. Anders als der Monats-Grant verfallen diese Credits nicht."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@로 풀에 %1$@을(를) 추가합니다 — 수수료 없음. 월간 지급분과 달리 이 크레딧은 만료되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет в пул %@ за %@ — без комиссии. В отличие от месячного гранта эти кредиты не сгорают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 %2$@ 为积分池添加 %1$@——无手续费。与每月赠送不同，这些积分永不过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 %2$@ 為信用池添加 %1$@——無手續費。與每月贈送不同，這些信用永不過期。"
          }
        }
      }
    },
    "Adds %@ to workspace credits for %@ — no fee. Unlike the monthly grant, these credits don't expire." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt %1$@ zum Workspace-Guthaben von %2$@ hinzu – ohne Gebühr. Anders als das monatliche Guthaben verfallen diese Credits nicht."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 작업 공간 크레딧에 %1$@을(를) 추가합니다. 수수료는 없습니다. 월간 지급분과 달리 이 크레딧은 만료되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет %1$@ к кредитам рабочей области %2$@ без комиссии. В отличие от ежемесячного начисления, эти кредиты не сгорают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 %2$@ 的工作区额度增加 %1$@，无手续费。与每月发放的额度不同，这些额度不会过期。"
          }
        }
      }
    },
    "Adds every existing agent to the Orchestrator's allowed list." : {
