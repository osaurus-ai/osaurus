          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнение кода в песочнице."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沙盒代码执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沙盒程式碼執行。"
          }
        }
      }
    },
    "Sandboxed commands see ~/.osaurus/container/workspace/ as /workspace — the only directory they can write to. Open it in Finder to browse or edit files directly." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-Befehle sehen ~/.osaurus/container/workspace/ als /workspace — das einzige Verzeichnis, in das sie schreiben können. Öffnen Sie es im Finder, um Dateien direkt zu durchsuchen oder zu bearbeiten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샌드박스 명령은 ~/.osaurus/container/workspace/를 /workspace로 인식하며, 이는 쓸 수 있는 유일한 디렉터리입니다. Finder에서 열어 파일을 직접 탐색하거나 편집하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды в песочнице видят ~/.osaurus/container/workspace/ как /workspace — единственный каталог, доступный им для записи. Откройте его в Finder, чтобы просматривать или редактировать файлы напрямую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沙盒命令将 ~/.osaurus/container/workspace/ 视为 /workspace — 这是它们唯一可写入的目录。在访达中打开即可直接浏览或编辑文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沙盒命令將 ~/.osaurus/container/workspace/ 視為 /workspace — 這是它們唯一可寫入的目錄。在 Finder 中開啟即可直接瀏覽或編輯檔案。"
          }
        }
      }
    },
    "Sandboxed execution is unavailable on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-Ausführung ist auf diesem Gerät nicht verfügbar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 샌드박스 실행을 사용할 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнение в песочнице недоступно на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不支持沙盒执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置不支援沙盒執行。"
          }
        }
      }
    },
    "Sandboxed execution is unavailable on this device. Native plugins continue to work normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-Ausführung ist auf diesem Gerät nicht verfügbar. Native Plugins funktionieren weiterhin normal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 샌드박스 실행을 사용할 수 없습니다. 네이티브 플러그인은 계속 정상적으로 작동합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнение в песочнице недоступно на этом устройстве. Нативные плагины продолжают работать как обычно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不支持沙盒执行。原生插件仍可正常工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置不支援沙盒執行。原生插件仍可正常運作。"
          }
        }
      }
    },
    "Sandboxed MCP servers require macOS 26 or later and will fail to start on this Mac. Choose Host to run this provider — note it will then run without sandbox protection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-MCP-Server erfordern macOS 26 oder neuer und starten auf diesem Mac nicht. Wählen Sie „Host“, um diesen Provider auszuführen — beachten Sie, dass er dann ohne Sandbox-Schutz läuft."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샌드박스 MCP 서버는 macOS 26 이상이 필요하며 이 Mac에서는 시작되지 않습니다. 이 프로바이더를 실행하려면 호스트를 선택하세요 — 이 경우 샌드박스 보호 없이 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверы MCP в песочнице требуют macOS 26 или новее и не запустятся на этом Mac. Выберите «Хост», чтобы запустить этот провайдер — учтите, что тогда он будет работать без защиты песочницы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
