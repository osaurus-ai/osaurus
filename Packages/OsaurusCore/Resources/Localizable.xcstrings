        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델은 바로 이 Mac에서 실행돼요. 입력한 내용이 Mac 밖으로 나가지 않고, 오프라인에서도 작동해요."
          }
        },
        "ru" : {
          "stringUnit" : {
