        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 중 하나에서 이 버전과 동기화할 수 없는 Osaurus 버전이 실행 중입니다. 두 기기 모두 최신 버전으로 업데이트하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
