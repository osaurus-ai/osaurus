          }
        }
      }
    },
    "Your databases are encrypted with a 256-bit key in your macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Datenbanken werden mit einem 256-Bit-Schlüssel in Ihrem macOS-Schlüsselbund verschlüsselt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스는 macOS 키체인의 256비트 키로 암호화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши базы данных зашифрованы 256-битным ключом в вашей Связке ключей macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据库在 macOS 钥匙串中使用 256 位密钥进行加密。"
          }
        },
        "zh-Hant": {
