    },
    "Optional: add rules to reply in different %@s with different agents, or let a name prefix pick an agent inside a shared %@.": {
      "comment": "A footnote that describes the purpose of the editor.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Füge Regeln hinzu, um in verschiedenen %1$@s mit verschiedenen Agenten zu antworten, oder lass ein Namens-Präfix in einem gemeinsamen %2$@ einen Agenten auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Optional: add rules to reply in different %1$@s with different agents, or let a name prefix pick an agent inside a shared %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 규칙을 추가해 서로 다른 %1$@에서 서로 다른 에이전트로 답장하거나, 공유 %2$@ 안에서 이름 접두사로 에이전트를 선택하게 하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: добавьте правила, чтобы отвечать в разных %1$@ разными агентами, или пусть префикс имени выбирает агента внутри общего %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：添加规则以便在不同的 %1$@ 中由不同的智能体回复，或让名称前缀在共享 %2$@ 中选择智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選：新增規則以便在不同的%1$@中由不同的智能體回覆，或讓名稱前綴在共享%2$@中選擇智能體。"
          }
        }
      }
    },
