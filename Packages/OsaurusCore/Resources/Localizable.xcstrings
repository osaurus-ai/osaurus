          }
        }
      }
    },
    "Unloads model memory as soon as no active chat window or generation lease keeps it warm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entlädt den Modellspeicher, sobald kein aktives Chatfenster oder keine Generierungs-Lease ihn warm hält."
          }
