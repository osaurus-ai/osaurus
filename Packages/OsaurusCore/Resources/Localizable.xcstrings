          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить агентам отправлять сообщения в чаты из списка на запись через привязанный аккаунт. Глобальный переключатель отправки в разделе «Каналы» также должен быть включён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
