    },
    "The agent can no longer post here on its own. Waiting or drafted posts for this room can no longer be sent.": {
      "comment": "Confirmation message for removing a room from an agent.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent kann hier nicht mehr von sich aus posten. Wartende oder entworfene Posts für diesen Raum können nicht mehr gesendet werden."
