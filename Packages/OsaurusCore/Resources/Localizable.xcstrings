    "Save it somewhere safe. Anyone with these words can recover your identity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre es an einem sicheren Ort auf. Jeder mit diesen Wörtern kann deine Identität wiederherstellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 곳에 저장하세요. 이 단어들을 아는 사람은 누구든 사용자의 신원을 복구할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните его в безопасном месте. Любой, кто знает эти слова, может восстановить вашу идентификация."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
