    "Lets agents read on-screen elements and click, type, and scroll for you." : {
      "comment" : "Subtitle for the \"Accessibility\" computer use permission row.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
