    "Generate a new 256-bit key and re-encrypt every artifact. The old key is destroyed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Generate a new 256-bit key and re-encrypt every artifact. The old key is destroyed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 256비트 키를 생성하고 모든 아티팩트를 다시 암호화합니다. 이전 키는 파기됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новый 256-битный ключ и повторно зашифруйте каждый артефакт. Старый ключ уничтожен."
          }
        },
        "zh-Hans": {
