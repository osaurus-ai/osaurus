          }
        }
      }
    },
    "Your databases are not encrypted by Osaurus. macOS FileVault protects them at rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Datenbanken werden von Osaurus nicht verschlüsselt. macOS FileVault schützt sie im Ruhezustand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스는 Osaurus에 의해 암호화되지 않습니다. macOS FileVault가 유휴 상태에서 데이터를 보호합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши базы данных не зашифрованы Osaurus. macOS FileVault защищает их при хранении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
