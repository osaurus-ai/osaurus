    "This conversation can't be read on this Mac yet. It will open once another of your devices shares its key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Unterhaltung kann auf diesem Mac noch nicht gelesen werden. Sie öffnet sich, sobald ein anderes deiner Geräte den Schlüssel teilt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화는 아직 이 Mac에서 읽을 수 없습니다. 다른 기기가 키를 공유하면 열립니다."
          }
        },
        "ru" : {
          "stringUnit" : {
