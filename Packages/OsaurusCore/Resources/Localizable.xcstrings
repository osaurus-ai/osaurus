      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größere Modelle sind intelligenter, benötigen aber mehr Arbeitsspeicher – Ihr Mac hat %1$lld GB Arbeitsspeicher und %2$@ freien Speicherplatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bigger models are smarter but need more memory — your Mac has %1$lld GB memory and %2$@ free storage."
