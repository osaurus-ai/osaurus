    "Paused after %d failed charges (last: %@). Fix the card under Manage billing, then save to re-arm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert nach %d fehlgeschlagenen Abbuchungen (zuletzt: %@). Korrigiere die Karte unter „Abrechnung verwalten“ und speichere, um erneut zu aktivieren."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d회 결제 실패 후 일시 중지됨 (마지막: %@). 결제 관리에서 카드를 수정한 후 저장하면 다시 활성화됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостановлено после %d неудачных списаний (последнее: %@). Исправьте карту в разделе «Управление оплатой», затем сохраните, чтобы включить снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 次扣款失败后已暂停（最近：%@）。请在“管理账单”中修正银行卡，然后保存以重新启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 次扣款失敗後已暫停（最近：%@）。請在「管理帳單」中修正信用卡，然後儲存以重新啟用。"
          }
        }
      }
    },
