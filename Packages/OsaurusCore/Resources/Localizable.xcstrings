          }
        }
      }
    },
    "The token is stored in Keychain and is never written to the Discord configuration file.": {
      "comment": "A description of how the bot token is managed.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The token is stored in Keychain and is never written to the Discord configuration file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 키체인에 저장되며 Discord 구성 파일에 기록되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен хранится в Keychain и никогда не записывается в файл конфигурации Discord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌存储在钥匙串（Keychain）中，绝不会写入 Discord 配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌存儲在鑰匙串（Keychain）中，絕不會寫入 Discord 配置文件。"
          }
        }
      }
    },
    "The token is stored in Keychain and is never written to the Telegram configuration file.": {
      "comment": "A description below the Telegram bot token field, explaining that the token is stored in the user's keychain and not in the app's configuration file.",
      "extractionState": "stale",
