    "Batch this many tokens before sending an SSE chunk to the client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Batch this many tokens before sending an SSE chunk to the client."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라이언트에 SSE 청크를 보내기 전에 이만큼의 토큰을 일괄 처리합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакетируйте это количество токенов перед отправкой клиенту фрагмента SSE."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在向客户端发送 SSE 数据块之前，先按此数量批量累积 token。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在向客戶端發送 SSE 數據塊之前，先按此數量批量累積 token。"
          }
        }
      }
    },
    "BatchEngine max batch size. 1 keeps the compile fast-path engaged; >1 enables continuous batching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BatchEngine max batch size. 1 keeps the compile fast-path engaged; >1 enables continuous batching."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatchEngine 최대 배치 크기입니다. 1은 컴파일 빠른 경로를 유지하고, 1보다 크면 연속 배치를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальный размер пакета BatchEngine. 1 поддерживает включенную быструю компиляцию; >1 включает непрерывное дозирование."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批量引擎最大批处理大小。设为 1 可保持编译快速路径启用；大于 1 则启用连续批处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批量引擎最大批處理大小。設爲 1 可保持編譯快速路徑啓用；大於 1 則啓用連續批處理。"
          }
        }
      }
