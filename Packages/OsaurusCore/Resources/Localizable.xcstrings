    "Use the installed model to catch names, addresses, and secrets that pattern rules miss. Turns on automatically when you install a model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das installierte Modell, um Namen, Adressen und Geheimnisse zu erkennen, die Musterregeln übersehen. Wird beim Installieren eines Modells automatisch aktiviert."
