    "Blank fields inherit your existing defaults. Changes apply to one submitted turn, including its tool steps and retries." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere Felder übernehmen deine bisherigen Standardwerte. Änderungen gelten für einen gesendeten Beitrag einschließlich seiner Werkzeugschritte und Wiederholungen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 필드는 기존 기본값을 따릅니다. 변경 사항은 도구 단계와 재시도를 포함하여 한 번 보낸 메시지에 적용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пустые поля наследуют текущие значения по умолчанию. Изменения применяются к одному отправленному сообщению, включая вызовы инструментов и повторные попытки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空的字段沿用现有默认值。更改适用于一条已提交的消息，包括其工具步骤和重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空的欄位沿用現有預設值。變更適用於一則提交的訊息，包括其工具步驟和重試。"
          }
        }
      }
    },
