    "Triggers in ~1 minute. Best for note-taking, wiki edits, and other active editing sessions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in ~1 Minute ausgelöst. Am besten für Notizen, Wiki-Bearbeitungen und andere aktive Bearbeitungssitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Triggers in ~1 minute. Best for note-taking, wiki edits, and other active editing sessions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 1분 내에 트리거됩니다. 메모 작성, 위키 편집 및 기타 활성 편집 세션에 가장 적합합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срабатывает через ~1 минуту. Лучше всего подходит для создания заметок, обезличивания вики-страниц и других активных сеансов обезличивания."
          }
        },
        "zh-Hans": {
