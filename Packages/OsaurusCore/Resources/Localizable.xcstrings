    "Check that the token is valid for this server (plan/scope) and pasted without a Bearer prefix or extra whitespace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob der Token für diesen Server gültig ist (Tarif/Scope) und ohne Bearer-Präfix oder zusätzliche Leerzeichen eingefügt wurde."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰이 이 서버에 유효한지(요금제/범위) 확인하고 Bearer 접두사나 불필요한 공백 없이 붙여넣었는지 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что токен действителен для этого сервера (тариф/область действия) и вставлен без префикса Bearer и лишних пробелов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认令牌对该服务器有效（套餐/权限范围），并且粘贴时没有 Bearer 前缀或多余的空格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
