      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst den Zugriff auf „%@“ über diesen Freigabelink. Du kannst später erneut eingeladen werden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유 링크를 통한 “%@” 접근 권한을 잃게 됩니다. 나중에 다시 초대받을 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы потеряете доступ к «%@» по этой ссылке. Вас могут пригласить снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将失去通过此共享链接访问“%@”的权限。之后可以再次被邀请。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將失去透過此共享連結存取「%@」的權限。之後可以再次被邀請。"
          }
        }
      }
    },
    "You'll lose access to shared agents; agents you shared are revoked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst den Zugriff auf geteilte Agenten; von dir geteilte Agenten werden widerrufen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 에이전트에 대한 접근 권한을 잃고, 내가 공유한 에이전트는 취소됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы потеряете доступ к общим агентам; агенты, которыми вы делились, будут отозваны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将失去对共享代理的访问权限；你共享的代理会被撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將失去對共享代理的存取權限；你共享的代理會被撤銷。"
          }
        }
      }
    },
    "You'll lose access to the workspace's shared agents and workspace credits. Your shared agents are revoked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst den Zugriff auf die geteilten Agenten und das Guthaben des Workspace. Deine geteilten Agenten werden widerrufen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간의 공유 에이전트와 작업 공간 크레딧에 대한 접근 권한을 잃게 됩니다. 공유한 에이전트는 취소됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы потеряете доступ к общим агентам и кредитам рабочей области. Агенты, которыми вы поделились, будут отозваны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将失去对工作区共享智能体和工作区额度的访问权限。你共享的智能体将被撤销。"
          }
        }
      }
    },
    "You'll lose access to the workspace's shared agents, workflows, and workspace credits. Your shared agents are revoked and your shared workflows leave its catalog." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst den Zugriff auf die geteilten Agenten, Workflows und Workspace-Guthaben. Deine geteilten Agenten werden widerrufen und deine geteilten Workflows verlassen seinen Katalog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll lose access to the workspace's shared agents, workflows, and workspace credits. Your shared agents are revoked and your shared workflows leave its catalog."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간의 공유 에이전트, 워크플로, 작업 공간 크레딧에 접근할 수 없게 됩니다. 공유한 에이전트는 해제되고 공유한 워크플로는 카탈로그에서 빠집니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы потеряете доступ к общим агентам, рабочим процессам и кредитам рабочей области. Ваши общие агенты будут отозваны, а ваши общие рабочие процессы покинут её каталог."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将无法再访问该工作区的共享智能体、工作流和工作区额度。你共享的智能体会被撤销，共享的工作流会从其目录中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將無法再存取該工作空間的共享智能體、工作流程和工作空間額度。你分享的智能體會被撤銷，分享的工作流程會從其目錄中移除。"
          }
        }
      }
    },
