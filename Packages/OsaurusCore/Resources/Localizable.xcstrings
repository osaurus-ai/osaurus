    "Not enough free disk space — this model needs %@ and this Mac has %@ free. Free up space and try again." : {
      "comment" : "Warning text displayed when a model download cannot fit on the user's Mac due to insufficient free disk space. The first argument is the formatted size of the model download. The second argument is the formatted free disk space on the user's Mac.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Speicherplatz – dieses Modell benötigt %1$@, auf diesem Mac sind %2$@ frei. Geben Sie Speicherplatz frei und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough free disk space — this model needs %1$@ and this Mac has %2$@ free. Free up space and try again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 여유 공간이 부족합니다 — 이 모델의 필요 공간은 %1$@, 이 Mac의 여유 공간은 %2$@입니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободного места на диске — модели нужно %1$@, а на этом Mac свободно %2$@. Освободите место и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘可用空间不足——此模型需要 %1$@，而这台 Mac 仅剩 %2$@。请释放空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盤可用空間不足——此模型需要 %1$@，而這臺 Mac 僅剩 %2$@。請釋放空間後重試。"
          }
        }
      }
    },
    "Want a different one later? You can add more models any time in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später lieber ein anderes? Du kannst jederzeit in den Einstellungen weitere Modelle hinzufügen."
