          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n8n 发送 %@: sha256=<请求正文原文的十六进制 HMAC-SHA256>。轮询请求对空正文签名。"
          }
        }
      }
    },
