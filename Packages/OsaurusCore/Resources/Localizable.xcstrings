    "Hold a specific app to a stricter stance than your default. A rule can only add caution, never remove it." : {
      "comment" : "A description of how to create custom rules for individual apps.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setzen Sie für eine bestimmte App eine strengere Richtlinie als Ihre Standardvorgabe. Eine Regel kann Vorsicht nur erhöhen, niemals abschwächen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특정 앱에 대해 기본값보다 더 엄격한 기준을 적용합니다. 규칙은 주의 수준을 높일 수만 있으며 낮출 수는 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите для конкретного приложения более строгие требования, чем по умолчанию. Правило может только добавить осторожности, но никогда не убрать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对特定应用设置比默认更严格的策略。规则只能增加谨慎程度，绝不能降低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對特定應用設置比默認更嚴格的策略。規則只能增加謹慎程度，絕不能降低。"
          }
        }
      }
    },
    "Hold new tasks without starting them. Running tasks finish." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Aufgaben zurückhalten, ohne sie zu starten. Laufende Aufgaben laufen zu Ende."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 작업을 시작하지 않고 보류합니다. 실행 중인 작업은 끝까지 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые задачи удерживаются без запуска. Выполняемые задачи завершатся."
