    "Not a DFlash 2 drafter — no selector in its config.json.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein DFlash-2-Drafter — in der config.json fehlt der Selector."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash 2 드래프터가 아닙니다 — config.json에 셀렉터가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не черновая модель DFlash 2 — в config.json нет селектора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 DFlash 2 草稿模型 — 其 config.json 中没有选择器。"
