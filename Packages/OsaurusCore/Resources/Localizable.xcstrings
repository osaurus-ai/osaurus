        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此智能体被允许在后台自行运行的频率。智能体将在此范围内自行选择下次运行时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
