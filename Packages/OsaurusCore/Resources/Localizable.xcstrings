    "Your own chats with this agent bill %@ today. On moves them to this workspace's credits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine eigenen Chats mit diesem Agenten werden derzeit über %@ abgerechnet. Ein stellt sie auf das Guthaben dieses Workspace um."
