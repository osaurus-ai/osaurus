          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 在应用运行时持续向 Telegram 请求新消息（长轮询）。仅在另一个程序轮询同一机器人时才关闭此功能。"
