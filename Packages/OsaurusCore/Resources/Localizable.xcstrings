    "One or more Azure deployment names — comma or newline-separated. Stored as the provider's model list." : {
      "comment" : "Help text under the Azure deployments field in the credential sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder mehrere Azure-Deployment-Namen – durch Komma oder Zeilenumbruch getrennt. Wird als Modellliste des Anbieters gespeichert."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나 이상의 Azure 배포 이름 — 쉼표 또는 줄 바꿈으로 구분됩니다. 제공자의 모델 목록으로 저장됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно или несколько имен развертывания Azure, разделенных запятыми или новой строкой. Хранится в виде списка моделей провайдера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个或多个 Azure 部署名称——以逗号或换行分隔。将作为该提供商的模型列表存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個或多個 Azure 部署名稱——以逗號或換行分隔。將作爲該提供商的模型列表存儲。"
          }
        }
      }
    },
    "One or more checks could not be proven; copy the report for support or CI proof." : {
