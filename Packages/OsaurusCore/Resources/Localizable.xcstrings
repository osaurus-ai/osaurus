    "Pin a saved view from the Views tab to make it appear here. Use this Home tab as the agent's at-a-glance dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hefte eine gespeicherte Ansicht aus dem Tab „Ansichten“ an, damit sie hier erscheint. Verwende diesen Tab „Start“ als Dashboard mit dem Überblick über den Agenten."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 표시되도록 '보기' 탭에서 저장된 보기를 고정하세요. 이 '홈' 탭을 에이전트의 한눈에 보기 대시보드로 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите сохранённое представление на вкладке «Представления», чтобы оно появилось здесь. Используйте вкладку «Главная» в качестве наглядной информационной панели агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“视图”标签页置顶一个已保存的视图，使其显示在此处。可将此“主页”标签页用作智能体的一览式仪表板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從「視圖」標籤頁置頂一個已保存的視圖，使其顯示在此處。可將此「主頁」標籤頁用作智能體的一覽式儀錶板。"
          }
        }
      }
    },
