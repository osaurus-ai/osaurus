          }
        }
      }
    },
    "This only applies to this chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies gilt nur fuer diesen Chat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 이 채팅에만 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это касается только этого чата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅适用于本次对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這僅適用於本次對話。"
          }
        }
      }
    },
    "This peer runs an older Osaurus without the Secure Channel. Agent chat is refused until it upgrades — no plaintext fallback.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gegenstelle nutzt eine ältere Osaurus-Version ohne Secure Channel. Agenten-Chat wird bis zum Upgrade abgelehnt — kein Klartext-Fallback."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피어는 보안 채널이 없는 이전 버전의 Osaurus를 실행 중입니다. 업그레이드할 때까지 에이전트 채팅이 거부되며, 일반 텍스트 폴백이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот одноранговый узел использует более старую версию Osaurus без безопасного канала. Чат агента отклоняется до тех пор, пока он не будет обновлен — без резервного варианта незашифрованного текста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方运行的是不支持安全通道的旧版 Osaurus。在其升级之前，智能体聊天将被拒绝——不会回退到明文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方運行的是不支持安全通道的舊版 Osaurus。在其升級之前，智能體聊天將被拒絕——不會回退到明文。"
          }
        }
      }
    },
    "This peer will lose access immediately. Their access key will be revoked.": {
      "comment": "Message displayed when revoking access to a peer.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This peer will lose access immediately. Their access key will be revoked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피어는 즉시 액세스 권한을 잃게 됩니다. 액세스 키가 취소됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот узел немедленно потеряет доступ. Их ключ доступа будет отозван."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该用户将立即失去访问权限，其访问密钥将被吊销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該用戶將立即失去訪問權限，其訪問密鑰將被吊銷。"
          }
        }
      }
    },
    "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile.": {
      "comment": "A message in an alert that lets the user know that resetting a browser session is destructive and will delete the user's browsing data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes %@'s browsing data — cookies, sign-ins, and history. The agent starts over with a fresh profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除 %@ 的浏览数据 — cookie、登录信息及历史记录。该智能体将以全新的配置文件重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除 %@ 的瀏覽資料 — cookie、登入資訊及歷史記錄。代理將以全新的設定檔重新開始。"
          }
        }
      }
    },
    "This permanently deletes every agent's browsing data — all cookies, sign-ins, and history.": {
      "comment": "A message displayed in an alert when resetting all browser sessions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes every agent's browsing data — all cookies, sign-ins, and history."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes every agent's browsing data — all cookies, sign-ins, and history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This permanently deletes every agent's browsing data — all cookies, sign-ins, and history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有智能体的浏览数据 — 所有 cookie、登录信息和历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所有代理的瀏覽資料 — 所有 cookie、登入資訊和歷史記錄。"
          }
        }
      }
    },
    "This permanently deletes the plugin's installed dylib, manifest, and per-agent secrets from disk. The host will stop attempting to load it on every launch — the only way to escape a crash-looping plugin without editing files by hand. You can reinstall it later from the Tools manager.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies loescht dauerhaft die installierte dylib, das Manifest und die agentenbezogenen Geheimnisse des Plugins von der Festplatte. Der Host wird aufhoeren, es bei jedem Start zu laden – der einzige Weg, einem abstuerzenden Plugin zu entkommen, ohne Dateien manuell zu bearbeiten. Sie koennen es spaeter ueber den Werkzeuge-Manager neu installieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인에 설치된 dylib, 매니페스트 및 에이전트별 비밀을 디스크에서 영구적으로 삭제합니다. 호스트는 매 시작 시 플러그인 로드 시도를 중지합니다. 파일을 직접 편집하지 않고 충돌이 반복되는 플러그인을 벗어나는 유일한 방법입니다. 나중에 도구 관리자에서 다시 설치할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит с диска установленную библиотеку dylib, манифест и секреты каждого агента. Хост прекратит попытки загрузить его при каждом запуске — единственный способ избежать зацикливания плагина без обезличивания файлов вручную. Вы можете переустановить его позже из диспетчера инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从磁盘上永久删除该插件已安装的动态库（dylib）、清单文件以及每个智能体的密钥。宿主将在每次启动时停止尝试加载该插件——这是无需手动编辑文件就能摆脱导致崩溃循环的插件的唯一方法。你稍后可以通过“工具管理器”重新安装它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從磁盤上永久刪除該插件已安裝的動態庫（dylib）、清單文件以及每個智能體的密鑰。宿主將在每次啓動時停止嘗試加載該插件——這是無需手動編輯文件就能擺脫導致崩潰循環的插件的唯一方法。您稍後可以通過「工具管理器」重新安裝它。"
          }
        }
      }
    },
    "This permanently deletes the selected memory row and removes its vector document when present.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch wird die ausgewählte Speicherzeile dauerhaft gelöscht und ihr Vektordokument entfernt, wenn es vorhanden ist."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 메모리 행을 영구적으로 삭제하고, 있는 경우 벡터 문서도 제거합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит выбранную строку памяти и удалит ее векторный документ, если он присутствует."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该操作会永久删除选中的记忆行，如果存在对应的向量文档，也会同步移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該操作會永久刪除選中的記憶行，如果存在對應的向量文檔，也會同步移除。"
          }
        }
      }
    },
    "This plugin declared an option you can configure (1 field).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This plugin declared an option you can configure (1 field)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
