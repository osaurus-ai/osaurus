        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инвариант двигателя. Отключение приводит к ошибке проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎不变约束。禁用会产生校验错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
