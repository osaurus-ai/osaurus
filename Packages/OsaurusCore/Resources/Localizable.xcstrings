    "This URL answers like an MCP server, not a chat completions API. Add it under Tools & MCP > Services instead of as an API provider." : {
      "comment" : "User-facing replacement for the generic discovery failure once the base URL has been identified as an MCP server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese URL antwortet wie ein MCP-Server, nicht wie eine Chat-Completions-API. Füge sie unter „Tools & MCP > Dienste“ hinzu statt als API-Anbieter."
          }
        },
        "ko" : {
          "stringUnit" : {
