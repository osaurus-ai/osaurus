    "Streaming replies are restored on the fly so chat reads naturally." : {
      "comment" : "Description of a privacy filter benefit that allows live unscrubbing of chat replies.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
