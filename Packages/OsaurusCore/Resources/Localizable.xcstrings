          }
        }
      }
    },
    "Your code is checked securely when you redeem.": {
      "comment": "A description of how the user's code is protected when redeeming.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Code wird beim Einlösen sicher geprüft."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
