    "A great everyday model for chat and writing." : {
      "comment" : "Plain-language one-liner for a chooser row, derived from the curated use case instead of the catalog description. The raw descriptions are written for the Models tab and lean on exactly the vocabulary first-timers shouldn",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großartiges Alltagsmodell für Chat und Texte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅과 글쓰기에 알맞은 뛰어난 일상용 모델입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отличная повседневная модель для чата и текстов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合日常聊天和写作的出色模型。"
