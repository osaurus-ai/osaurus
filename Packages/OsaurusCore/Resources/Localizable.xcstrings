          }
        }
      }
    },
    "The model is still generating a reply. Continue in the background and track progress in the menu-bar notch, or stop now.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Modell generiert noch eine Antwort. Im Hintergrund fortsetzen und den Fortschritt in der Menuezeile verfolgen, oder jetzt stoppen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 아직 응답을 생성하고 있습니다. 백그라운드에서 계속하고 메뉴 막대 노치에서 진행률을 추적하거나 지금 중지하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель все ещё генерирует ответ. Продолжайте работу в фоновом режиме и отслеживайте прогресс в строке меню или остановитесь сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型仍在生成回复。可在后台继续，并通过菜单栏凹槽跟踪进度，或立即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型仍在生成回復。可在後臺繼續，並通過菜單欄凹槽跟蹤進度，或立即停止。"
          }
        }
      }
    },
