    "The token is stored in Keychain and is never written to the Discord configuration file." : {
      "comment" : "A description of how the bot token is managed.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The token is stored in Keychain and is never written to the Discord configuration file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰은 키체인에 저장되며 Discord 구성 파일에 기록되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
