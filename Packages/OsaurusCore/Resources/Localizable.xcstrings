    },
    "A teammate shared an invite link with you. Join to see the workspace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teammitglied hat einen Einladungslink mit dir geteilt. Tritt bei, um den Workspace zu sehen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팀원이 초대 링크를 공유했습니다. 참여하면 워크스페이스를 볼 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Участник рабочего пространства поделился с вами ссылкой-приглашением. Присоединитесь, чтобы увидеть рабочее пространство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有队友向你分享了邀请链接。加入后即可查看工作区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
