          }
        }
      }
    },
    "This Mac, confined by a sandbox profile" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac, eingeschränkt durch ein Sandbox-Profil"
