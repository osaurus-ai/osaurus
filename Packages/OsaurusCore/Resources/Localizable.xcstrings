          "stringUnit" : {
            "state" : "translated",
            "value" : "더 큰 모델은 더 똑똑하지만 더 많은 메모리가 필요합니다 — 이 Mac은 메모리 %1$lld GB, 여유 저장 공간 %2$@입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
