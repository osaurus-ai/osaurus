          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allowlists limit which spaces and rooms this connection can inspect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表限制此连接可以检查的空间和房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許清單限制此連線可以檢查的空間和房間。"
          }
        }
      }
    },
    "Allows capturing screenshots and system audio when you approve those features.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt das Aufnehmen von Screenshots und System-Audio, wenn du diese Funktionen genehmigst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기능을 승인하면 스크린샷 및 시스템 오디오를 캡처할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет делать снимки экрана и системный звук, когда вы одобряете эти функции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在你批准这些功能时捕获屏幕截图和系统音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許在你批准這些功能時捕獲屏幕截圖和系統音頻。"
          }
        }
      }
    },
    "Allows Osaurus to send messages through Messages.app via Apple Events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Osaurus, Nachrichten über Apple Events durch Messages.app zu senden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus가 Apple 이벤트를 통해 Messages.app으로 메시지를 보낼 수 있도록 허용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет Osaurus отправлять сообщения через Messages.app с помощью Apple Events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Osaurus 通过 Apple Events 使用 Messages.app 发送消息。"
          }
        }
      }
    },
    "Allows plugins to access and search contacts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf Kontakte zuzugreifen und sie zu durchsuchen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 연락처에 접근하고 검색할 수 있도록 허용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет плагинам получать доступ к контактам и осуществлять их поиск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许插件访问并搜索联系人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許插件訪問並搜索聯繫人。"
          }
        }
      }
    },
    "Allows plugins to access protected files like the Messages database and other app data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf geschützte Dateien wie die Nachrichten-Datenbank und andere App-Daten zuzugreifen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 메시지 데이터베이스 및 기타 앱 데이터와 같은 보호된 파일에 접근할 수 있도록 허용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет плагинам получать доступ к защищенным файлам, таким как база данных сообщений и другим данным приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许插件访问受保护文件，例如“信息”数据库和其他 App 数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許插件訪問受保護文件，例如「信息」數據庫和其他 App 數據。"
          }
        }
      }
    },
    "Allows plugins to access your calendar to read and create events directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, direkt auf deinen Kalender zuzugreifen, um Termine zu lesen und zu erstellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 캘린더에 접근하여 이벤트를 직접 읽고 생성할 수 있도록 허용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет плагинам получать доступ к вашему календарю для непосредственного чтения и создания событий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许插件访问你的日历，直接读取和创建事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許插件訪問你的日曆，直接讀取和創建事件。"
          }
        }
      }
    },
