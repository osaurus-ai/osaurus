        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 시크릿(Client Secret)은 macOS 키체인에 저장되며 %@에만 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш секрет клиента хранится в вашей Связке ключей macOS и отправляется только на %@."
          }
