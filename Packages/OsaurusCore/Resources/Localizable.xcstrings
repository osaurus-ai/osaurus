    "Skills are automatically available to every custom agent and load only when relevant. Type /skill-name in chat to use one explicitly.": {
      "comment": "A one-line explanation of the library contract: no toggles, no per-agent assignment — everything installed is available to custom agents. Type /skill-name in chat to use one explicitly.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skills are automatically available to every custom agent and load only when relevant. Type /skill-name in chat to use one explicitly."
          }
        },
        "ko": {
