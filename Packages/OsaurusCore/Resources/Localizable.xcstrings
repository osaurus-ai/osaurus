    "Sending is paused everywhere — replies and new messages. Agents can still read allowlisted channels.": {
      "comment": "Tooltip text for the \"Master switch for replies and new messages. Agents may send to write-allowlisted destinations.\" toggle.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
