          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰으로 푸시합니다. 아직 전달은 지원되지 않으며 이를 위해 휴대폰 토큰이 보관됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-уведомления на телефон. Доставка пока недоступна; токен телефона сохраняется для неё."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
