        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有此链接的人都可以安装此主题。主题 JSON 是公开的——请勿在自定义主题中分享密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
