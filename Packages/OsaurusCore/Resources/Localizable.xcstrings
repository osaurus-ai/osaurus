      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angeforderte Ressource wurde nicht gefunden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到所请求的资源。"
          }
        }
      }
    },
    "The Sandbox runs code in a Linux container on your Mac. Agents can execute commands, install packages, and work with files — fully isolated from your system.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sandbox führt Code in einem Linux-Container auf deinem Mac aus. Agenten können Befehle ausführen, Pakete installieren und mit Dateien arbeiten – komplett isoliert von deinem System."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒在 Mac 上的 Linux 容器中运行代码。代理可以执行命令、安装软件包和处理文件——与您的系统完全隔离。"
          }
        }
      }
    },
    "The service is temporarily unavailable. Please try again later.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst ist vorübergehend nicht erreichbar. Bitte später erneut versuchen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务暂时不可用。请稍后重试。"
