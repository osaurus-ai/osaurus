          }
        }
      }
    },
    "This model needs ~%@ GB to load and memory is at %@%% of %@ GB. Close other apps for best performance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Modell benötigt zum Laden ~%1$@ GB und der Speicher ist zu %2$@%% von %3$@ GB belegt. Schließe andere Apps für die beste Leistung."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 모델을 로드하려면 약 %1$@GB가 필요하며 메모리가 %3$@GB 중 %2$@%% 사용 중입니다. 최상의 성능을 위해 다른 앱을 닫으세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для загрузки этой модели нужно ~%1$@ ГБ, память заполнена на %2$@%% из %3$@ ГБ. Закройте другие приложения для лучшей производительности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载此模型需要约 %1$@ GB，内存已使用 %3$@ GB 中的 %2$@%%。关闭其他应用可获得最佳性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入此模型需要約 %1$@ GB，目前記憶體已使用 %3$@ GB 的 %2$@%%。關閉其他應用可獲得最佳效能。"
          }
        }
      }
    },
    "This model needs ~%@ GB to load, but memory is at %@%% of %@ GB. Sending is paused until memory frees — close other apps or pick a smaller model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Modell benötigt zum Laden ~%1$@ GB, aber der Speicher ist zu %2$@%% von %3$@ GB belegt. Das Senden ist pausiert, bis Speicher frei wird — schließe andere Apps oder wähle ein kleineres Modell."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 모델을 로드하려면 약 %1$@GB가 필요하지만 메모리가 %3$@GB 중 %2$@%% 사용 중입니다. 메모리가 확보될 때까지 전송이 일시 중지됩니다 — 다른 앱을 닫거나 더 작은 모델을 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для загрузки этой модели нужно ~%1$@ ГБ, но память заполнена на %2$@%% из %3$@ ГБ. Отправка приостановлена, пока память не освободится — закройте другие приложения или выберите меньшую модель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载此模型需要约 %1$@ GB，但内存已使用 %3$@ GB 中的 %2$@%%。发送已暂停，等待内存释放 — 请关闭其他应用或选择更小的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入這個模型大概需要 %1$@ GB 的空間，但現在已經使用了 %3$@ GB 中的 %2$@%。傳送已經暫停，正在等待釋放記憶體——請關閉其他應用程式或選擇一個較小的模型。"
          }
        }
      }
    },
    "This model needs ~%@ GB, but this Mac can only keep ~%@ GB on the GPU. macOS will page the weights and generation will be extremely slow — pick a smaller model or a lower-precision build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This model needs ~%1$@ GB, but this Mac can only keep ~%2$@ GB on the GPU. macOS will page the weights and generation will be extremely slow — pick a smaller model or a lower-precision build."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This model needs ~%1$@ GB, but this Mac can only keep ~%2$@ GB on the GPU. macOS will page the weights and generation will be extremely slow — pick a smaller model or a lower-precision build."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This model needs ~%1$@ GB, but this Mac can only keep ~%2$@ GB on the GPU. macOS will page the weights and generation will be extremely slow — pick a smaller model or a lower-precision build."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This model needs ~%1$@ GB, but this Mac can only keep ~%2$@ GB on the GPU. macOS will page the weights and generation will be extremely slow — pick a smaller model or a lower-precision build."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模型需要约 %1$@ GB，但此 Mac 在 GPU 上只能保持约 %2$@ GB。macOS 将会对权重进行分页，生成速度会非常慢 — 请选择更小的模型或更低精度的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模型需要約 %1$@ GB，但此 Mac 在 GPU 上只能保持約 %2$@ GB。macOS 將會對權重進行分頁，生成速度會非常慢 — 請選擇更小的模型或更低精度的版本。"
          }
        }
      }
    },
    "This only applies to this chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies gilt nur fuer diesen Chat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 이 채팅에만 적용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это касается только этого чата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这仅适用于本次对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這僅適用於本次對話。"
          }
        }
      }
    },
    "This peer runs an older Osaurus without the Secure Channel. Agent chat is refused until it upgrades — no plaintext fallback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gegenstelle nutzt eine ältere Osaurus-Version ohne Secure Channel. Agenten-Chat wird bis zum Upgrade abgelehnt — kein Klartext-Fallback."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 피어는 보안 채널이 없는 이전 버전의 Osaurus를 실행 중입니다. 업그레이드할 때까지 에이전트 채팅이 거부되며, 일반 텍스트 폴백이 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот одноранговый узел использует более старую версию Osaurus без безопасного канала. Чат агента отклоняется до тех пор, пока он не будет обновлен — без резервного варианта незашифрованного текста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方运行的是不支持安全通道的旧版 Osaurus。在其升级之前，智能体聊天将被拒绝——不会回退到明文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方運行的是不支持安全通道的舊版 Osaurus。在其升級之前，智能體聊天將被拒絕——不會回退到明文。"
          }
        }
      }
    },
    "This peer will lose access immediately. Their access key will be revoked." : {
      "comment" : "Message displayed when revoking access to a peer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This peer will lose access immediately. Their access key will be revoked."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 피어는 즉시 액세스 권한을 잃게 됩니다. 액세스 키가 취소됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот узел немедленно потеряет доступ. Их ключ доступа будет отозван."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该用户将立即失去访问权限，其访问密钥将被吊销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該用戶將立即失去訪問權限，其訪問密鑰將被吊銷。"
          }
        }
      }
    },
    "This permanently deletes the plugin's installed dylib, manifest, and per-agent secrets from disk. The host will stop attempting to load it on every launch — the only way to escape a crash-looping plugin without editing files by hand. You can reinstall it later from the Tools manager." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies loescht dauerhaft die installierte dylib, das Manifest und die agentenbezogenen Geheimnisse des Plugins von der Festplatte. Der Host wird aufhoeren, es bei jedem Start zu laden – der einzige Weg, einem abstuerzenden Plugin zu entkommen, ohne Dateien manuell zu bearbeiten. Sie koennen es spaeter ueber den Werkzeuge-Manager neu installieren."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인에 설치된 dylib, 매니페스트 및 에이전트별 비밀을 디스크에서 영구적으로 삭제합니다. 호스트는 매 시작 시 플러그인 로드 시도를 중지합니다. 파일을 직접 편집하지 않고 충돌이 반복되는 플러그인을 벗어나는 유일한 방법입니다. 나중에 도구 관리자에서 다시 설치할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит с диска установленную библиотеку dylib, манифест и секреты каждого агента. Хост прекратит попытки загрузить его при каждом запуске — единственный способ избежать зацикливания плагина без обезличивания файлов вручную. Вы можете переустановить его позже из диспетчера инструментов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从磁盘上永久删除该插件已安装的动态库（dylib）、清单文件以及每个智能体的密钥。宿主将在每次启动时停止尝试加载该插件——这是无需手动编辑文件就能摆脱导致崩溃循环的插件的唯一方法。您稍后可以通过“工具管理器”重新安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從磁盤上永久刪除該插件已安裝的動態庫（dylib）、清單文件以及每個智能體的密鑰。宿主將在每次啓動時停止嘗試加載該插件——這是無需手動編輯文件就能擺脫導致崩潰循環的插件的唯一方法。您稍後可以通過「工具管理器」重新安裝它。"
          }
        }
      }
    },
