        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Stripe 的“开发者 → Webhook”中将该 URL 添加为端点，然后将端点的签名密钥（whsec_…）粘贴到自动化中。"
          }
        }
      }
    },
