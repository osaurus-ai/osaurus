    "If the day doesn't exist in a month, it will run on the last day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Tag in einem Monat nicht existiert, wird am letzten Tag ausgeführt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 월에 지정한 날짜가 없으면 마지막 날에 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если день не существует в месяце, он будет выполняться в последний день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
