    "When off, Osaurus pins the BatchEngine to one active slot even if Concurrent Sessions is higher." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "When off, Osaurus pins the BatchEngine to one active slot even if Concurrent Sessions is higher."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 끄면 동시 세션 수가 더 높더라도 Osaurus가 BatchEngine을 하나의 활성 슬롯에 고정합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если параметр Osaurus выключен, он закрепляет BatchEngine в одном активном слоте, даже если число одновременных сеансов выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
