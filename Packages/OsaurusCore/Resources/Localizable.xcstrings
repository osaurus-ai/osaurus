    "Browser Use is off by default and can only be enabled per custom agent — the built-in Default agent never gets browser access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and can only be enabled per custom agent — the built-in Default agent never gets browser access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and can only be enabled per custom agent — the built-in Default agent never gets browser access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and can only be enabled per custom agent — the built-in Default agent never gets browser access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器使用默认关闭，只能为自定义智能体启用 — 内置的默认智能体永远不会获得浏览器访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器使用預設關閉，只能為自訂代理啟用 — 內建的預設代理永遠不會獲得瀏覽器存取權限。"
          }
        }
      }
    },
    "Browser Use is off by default and only custom agents can use it. Open a custom agent's Subagents tab and flip on Browser Use — optionally with a dedicated model for browsing. Review or reset each agent's session in the new Browser settings tab.": {
      "comment": "What's New (0.22.9) page body — enabling Browser Use.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and only custom agents can use it. Open a custom agent's Subagents tab and flip on Browser Use — optionally with a dedicated model for browsing. Review or reset each agent's session in the new Browser settings tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and only custom agents can use it. Open a custom agent's Subagents tab and flip on Browser Use — optionally with a dedicated model for browsing. Review or reset each agent's session in the new Browser settings tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser Use is off by default and only custom agents can use it. Open a custom agent's Subagents tab and flip on Browser Use — optionally with a dedicated model for browsing. Review or reset each agent's session in the new Browser settings tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器使用默认关闭，仅自定义智能体可使用。打开自定义智能体的“子智能体”标签页，开启浏览器使用 — 可选择专用浏览模型。在新增的“浏览器”设置标签页中查看或重置每个智能体的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器使用預設關閉，僅自訂智慧體可使用。開啟自訂智慧體的「子智慧體」標籤頁，開啟瀏覽器使用 — 可選擇專用瀏覽模型。在新建的瀏覽器設定標籤頁中檢視或重設每個智慧體的工作階段。"
          }
        }
      }
    },
