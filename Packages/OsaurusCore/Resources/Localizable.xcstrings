          }
        }
      }
    },
    "The reply stayed in Osaurus because sending is paused. Turn on Allow Agents to Send Messages in Channels to post replies back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort ist in Osaurus geblieben, weil das Senden pausiert ist. Schalte in Kanäle „Agenten dürfen Nachrichten senden“ ein, um Antworten zurückzuschicken."
