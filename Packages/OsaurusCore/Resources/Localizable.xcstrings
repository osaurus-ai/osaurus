    "Agent traffic is protected by the Osaurus Secure Channel: forward-secret, mutually authenticated end-to-end encryption.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agenten-Datenverkehr ist durch den Osaurus Secure Channel geschützt: Ende-zu-Ende-Verschlüsselung mit Forward Secrecy und beidseitiger Authentifizierung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
