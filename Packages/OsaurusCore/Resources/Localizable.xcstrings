    "insights.body.caption.local.request": {
      "comment": "Caption under the Request tab's Local sub-toggle in Insights, describing the body as the unscrubbed payload your local app handed to Osaurus.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was deine App an Osaurus gesendet hat (ungeschwärzt)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your app sent to Osaurus (unscrubbed)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 앱이 Osaurus에 보낸 내용(비식별화 안 됨)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что ваше приложение отправило на Osaurus (не очищено)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的应用发送给 Osaurus 的内容（未脱敏）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的應用發送給 Osaurus 的內容（未脫敏）"
          }
        }
      }
    },
    "insights.body.caption.local.response": {
      "comment": "Caption under the Response tab's Local sub-toggle in Insights, describing the body as the post-unscrub stream Osaurus handed back to your app.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
