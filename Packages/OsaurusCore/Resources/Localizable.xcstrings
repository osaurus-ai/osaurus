    "Leave empty to use %@. Set it only when the sender can't change the header it sends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um %@ zu verwenden. Nur setzen, wenn der Absender den gesendeten Header nicht ändern kann."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워 두면 %@을(를) 사용합니다. 보내는 쪽이 헤더를 바꿀 수 없을 때만 설정하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать %@. Указывайте, только если отправитель не может изменить отправляемый заголовок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用 %@。仅当发送方无法更改其发送的请求头时才设置。"
          }
        }
      }
    },
