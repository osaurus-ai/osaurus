    "Just a moment — making your signature now." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Moment – deine Signatur wird jetzt erstellt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠시만 기다려 주세요 — 서명을 생성하고 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минуточку — сделайте свою подпись сейчас."
          }
