    "Teammate access, runs on your shared agents, and your own workspace actions are recorded here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriffe von Teammitgliedern, Ausführungen auf deinen freigegebenen Agenten und deine eigenen Workspace-Aktionen werden hier aufgezeichnet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팀원 접근, 공유 에이전트 실행, 내 작업 공간 작업이 여기에 기록됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь записываются обращения коллег, запуски ваших общих агентов и ваши собственные действия в рабочей области."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队友的访问、在你共享代理上的运行以及你自己的工作区操作都会记录在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隊友的存取、在你共享代理上的執行以及你自己的工作空間操作都會記錄在這裡。"
          }
        }
      }
    },
    "Teammate's chat" : {
