    "“%@” could not be loaded for this agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte für diesen Agenten nicht geladen werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 이 에이전트에서 불러올 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не удалось загрузить для этого агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为此智能体加载“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法爲此智能體加載「%@」。"
          }
        }
      }
    },
    "\"%@\" will be removed permanently. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" will be removed permanently. This can't be undone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" will be removed permanently. This can't be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" 항목이 영구적으로 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» будет удалено навсегда. Это невозможно отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” 将被永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」 將被永久刪除。此操作無法撤銷。"
          }
        }
      }
    },
    "\"%@\" will be removed. Its conversations are kept and move out of the project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird entfernt. Die Unterhaltungen bleiben erhalten und werden aus dem Projekt gelöst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\"이(가) 제거됩니다. 대화는 유지되며 프로젝트에서만 분리됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» будет удалён. Разговоры сохранятся и будут исключены из проекта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\"将被移除。对话会保留并移出项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」將被移除。對話會保留並移出專案。"
          }
        }
      }
    },
