          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off means premium search stops at your remaining credits; everything else uses the built-in sources."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off means premium search stops at your remaining credits; everything else uses the built-in sources."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off means premium search stops at your remaining credits; everything else uses the built-in sources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭意味着高级搜索在剩余积分用完后停止；其他所有搜索使用内置源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
