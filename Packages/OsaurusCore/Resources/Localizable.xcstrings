            "state": "needs_review",
            "value": "Skills are automatically available to every custom agent and load only when relevant. Type /skill-name in chat to use one explicitly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能自动对每个自定义智能体可用，仅在相关时加载。在聊天中输入 /skill-name 以显式使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能自動對每個自訂智能體可用，僅在相關時載入。在聊天中輸入 /skill-name 以顯式使用。"
          }
        }
      }
    },
