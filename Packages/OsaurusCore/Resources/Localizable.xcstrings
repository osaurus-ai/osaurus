    "Agent shared with the workspace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent mit dem Workspace geteilt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트를 워크스페이스와 공유했습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
