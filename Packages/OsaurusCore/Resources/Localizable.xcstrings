          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет модели загруженными до тех пор, пока они не будут выгружены вручную. Требуется 32GB+ RAM."
          }
        },
        "zh-Hans": {
