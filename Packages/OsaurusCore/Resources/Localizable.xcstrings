    "Agents and the Orchestrator call it %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten und der Orchestrator rufen ihn als %@ auf."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트와 오케스트레이터는 %@(으)로 호출합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агенты и Оркестратор вызывают его как %@."
          }
